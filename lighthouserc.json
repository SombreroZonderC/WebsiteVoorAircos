{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4322/",
        "http://localhost:4322/airconditioning",
        "http://localhost:4322/warmtepompen",
        "http://localhost:4322/contact",
        "http://localhost:4322/kennisbank/hybride-of-all-electric",
        "http://localhost:4322/onderhoud"
      ],
      "numberOfRuns": 3,
      "startServerCommand": "node scripts/serve-dist.mjs",
      "startServerReadyPattern": "dist op"
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci-rapport"
    }
  }
}
