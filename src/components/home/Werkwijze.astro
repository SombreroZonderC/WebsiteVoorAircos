---
// "Zo werk ik": de vier stappen van eerste contact tot installatie.
import { home } from '../../lib/bedrijf';
---

<h2 class="hk eyebrow werkwijze-kop">Zo werk ik</h2>
<ol class="stappen">
  {
    home.werkwijze.map((s, i) => (
      <li>
        <span class="nr">{String(i + 1).padStart(2, '0')}</span>
        <h3>{s.titel}</h3>
        <p>{s.tekst}</p>
      </li>
    ))
  }
</ol>

<style>
  .stappen {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .stappen li {
    position: relative;
    padding: 26px 24px 0 0;
  }
  .stappen li::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 40px;
    height: 2px;
    background: var(--ink);
  }
  .nr {
    font-family: var(--font-mono);
    color: var(--ink);
    font-size: 0.85rem;
  }
  .stappen h3 {
    margin: 12px 0 6px;
  }
  .stappen p {
    margin: 0;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .stappen {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 24px;
    }
  }
</style>
