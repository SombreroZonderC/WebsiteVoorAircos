---
// Homepage: de opbouw in vlakken (donker ligt achter, licht schuift eroverheen) en de keuze
// koelen/verwarmen die alle secties aanstuurt. De secties zelf staan in components/home/.
import CtaBand from './CtaBand.astro';
import Hero from './home/Hero.astro';
import Keuze from './home/Keuze.astro';
import ZoWerktHet from './home/ZoWerktHet.astro';
import Resultaat from './home/Resultaat.astro';
import Werkwijze from './home/Werkwijze.astro';
import Sjoerd from './home/Sjoerd.astro';
import ReviewKaarten from './home/ReviewKaarten.astro';
---

<div class="home" data-modus="koel" data-home>
  <div class="paar">
    <div class="vlak donker plak" data-diepte-vlak data-geen-mobiele-cta>
      <div class="vlak-inhoud">
        <Hero />
      </div>
    </div>

    <section class="vlak licht paneel" aria-labelledby="keuze-titel">
      <Keuze />
    </section>
  </div>

  <div class="paar">
    <section class="vlak donker plak zo" data-diepte-vlak aria-labelledby="zo-titel">
      <div class="vlak-inhoud">
        <ZoWerktHet />
      </div>
    </section>

    <section class="vlak licht paneel tweede" aria-labelledby="resultaat-titel">
      <div class="wrap">
        <Resultaat />
        <Werkwijze />
        <Sjoerd />
        <ReviewKaarten />
      </div>
    </section>
  </div>

  <CtaBand />
</div>

<script>
  import { radiogroep } from '../scripts/radiogroep';

  const root = document.querySelector<HTMLElement>('[data-home]');
  if (root) {
    // Koelen / verwarmen: stuurt teksten, kaarten, tekening en de buitenthermometer aan
    const kantDelen = [...root.querySelectorAll<HTMLElement>('[data-m]')];
    const buiten = root.querySelector<HTMLElement>('#th-buiten')!;
    const graden = (t: number) => `${t < 0 ? '−' : ''}${Math.abs(t)}°`;
    radiogroep([...root.querySelectorAll<HTMLButtonElement>('[data-zet]')], {
      bijKeuze: (knop) => {
        const modus = knop.dataset.zet!;
        root.dataset.modus = modus;
        kantDelen.forEach((el) => (el.hidden = el.dataset.m !== modus));
        const t = modus === 'koel' ? 31 : -4;
        buiten.style.setProperty('--temp', String(t));
        buiten.querySelector('[data-waarde]')!.textContent = graden(t);
      },
    });
  }
</script>

<style>
  /* Kleur van de gekozen kant; de secties in components/home/ gebruiken --accent en --accent-d.
     Koppen (.hk) en doorklik-links (.door) delen de secties, daarom staan die hier. */
  .home {
    --accent: var(--blue-text);
    --accent-d: var(--blue-ice);
    background: var(--ink);
  }
  .home[data-modus='warm'] {
    --accent: var(--orange-text);
    --accent-d: var(--orange-hot);
  }
  .paneel {
    padding-bottom: clamp(80px, 10vw, 130px);
  }
  .home :global(.hk) {
    font-size: clamp(2.4rem, 5vw, 4.4rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    margin: 0 0 20px;
  }
  .home :global(.hk em) {
    font-style: normal;
    color: var(--accent);
  }
  .home :global(.hk.h2s) {
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    line-height: 1.05;
  }
  .zo .vlak-inhoud {
    padding: clamp(88px, 10vw, 140px) 0 clamp(100px, 11vw, 160px);
    background:
      radial-gradient(50% 60% at 80% 50%, rgb(255 255 255 / 0.04), transparent 70%),
      var(--ink);
  }
  .home :global(.door) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    font-weight: 700;
    color: var(--accent-d);
    text-decoration: none;
  }
  .home :global(.licht-door) {
    color: var(--accent);
    margin-top: 4px;
  }
  .home :global(.door:hover) {
    text-decoration: underline;
  }
  .home :global(.hk.werkwijze-kop) {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    margin: 0 0 14px;
  }
</style>
