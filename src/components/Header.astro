---
import Icon from './Icon.astro';
import { bedrijf, nav, telLink } from '../lib/bedrijf';

interface Props {
  /** Header meteen donker en compact (voor pagina's met licht direct onder de header) */
  vast?: boolean;
}
const { vast = false } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
---

<header class:list={['header', { scrolled: vast }]} data-header data-vast={vast ? '' : undefined}>
  <div class="bar">
    <a href="/" class="logo" aria-label={`${bedrijf.naam} – home`}>
      <img src="/images/logo-header.svg" alt="" width="132" height="58" />
    </a>

    <nav class="nav" id="hoofdmenu" aria-label="Hoofdmenu">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn menu-cta" href="/contact">Offerte aanvragen</a>
    </nav>

    <div class="right">
      <a class="phone" href={telLink} aria-label={`Bel ${bedrijf.telefoon.weergave}`}>
        <Icon name="phone" size={18} />
        <span>{bedrijf.telefoon.weergave}</span>
      </a>
      <a class="btn small" href="/contact">Offerte</a>
      <button class="toggle" aria-expanded="false" aria-controls="hoofdmenu" data-toggle>
        <span class="sr-only">Menu</span>
        <Icon name="menu" class="i-open" />
        <Icon name="close" class="i-close" />
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = header.querySelector<HTMLButtonElement>('[data-toggle]')!;

  const vast = header.hasAttribute('data-vast');
  const onScroll = () => header.classList.toggle('scrolled', vast || window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const zetMenu = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    header.classList.toggle('open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  };
  toggle.addEventListener('click', () => zetMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  header.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => zetMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header.classList.contains('open')) {
      zetMenu(false);
      toggle.focus();
    }
  });
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--text-on-dark);
    border-bottom: 1px solid transparent;
    transition:
      background 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }
  .header.scrolled,
  .header.open {
    background: rgb(5 9 11 / 0.95);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    border-bottom-color: var(--line-dark);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    height: var(--header-h);
    padding-inline: clamp(16px, 3vw, 36px);
    transition: height 0.3s var(--ease);
  }
  .scrolled .bar {
    height: 64px;
  }
  .logo img {
    height: 44px;
    width: auto;
    transition: height 0.3s var(--ease);
  }
  .scrolled .logo img {
    height: 36px;
  }
  .nav {
    margin-left: auto;
  }
  .nav ul {
    display: flex;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a:not(.btn) {
    display: block;
    padding: 8px 12px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.94rem;
    font-weight: 500;
    color: var(--muted-on-dark);
    transition:
      color 0.2s,
      background 0.2s;
  }
  .nav a:not(.btn):hover,
  .nav a[aria-current='page'] {
    color: #fff;
    background: rgb(255 255 255 / 0.08);
  }
  .menu-cta {
    display: none;
  }
  .right {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .phone :global(svg) {
    color: var(--orange-hot);
  }
  .btn.small {
    min-height: 42px;
    padding: 0 18px;
    font-size: 0.92rem;
    box-shadow: none;
  }
  .toggle {
    display: none;
    background: none;
    border: 1px solid var(--line-dark);
    color: inherit;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .toggle :global(.i-close),
  .open .toggle :global(.i-open) {
    display: none;
  }
  .open .toggle :global(.i-close) {
    display: block;
  }

  /* Hamburgermenu zodra niet alle links naast elkaar passen */
  @media (max-width: 1180px) {
    .toggle {
      display: inline-flex;
    }
    .right {
      margin-left: auto;
    }
    .nav {
      position: fixed;
      inset: var(--header-h) 0 0;
      margin: 0;
      overflow-y: auto;
      background: var(--ink);
      padding: 16px clamp(16px, 4vw, 40px) 32px;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition:
        opacity 0.25s var(--ease),
        transform 0.25s var(--ease),
        visibility 0.25s;
    }
    .scrolled .nav {
      inset: 64px 0 0;
    }
    .open .nav {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .nav ul {
      flex-direction: column;
      gap: 0;
    }
    .nav a:not(.btn) {
      font-family: var(--font-display);
      font-stretch: 110%;
      font-weight: 700;
      font-size: 1.5rem;
      color: #fff;
      padding: 14px 0;
      border-radius: 0;
      border-bottom: 1px solid var(--line-dark);
    }
    .nav a:not(.btn):hover,
    .nav a[aria-current='page'] {
      background: none;
      color: var(--orange-hot);
    }
    .menu-cta {
      display: flex;
      width: 100%;
      margin-top: 28px;
    }
  }
  @media (max-width: 640px) {
    .btn.small {
      display: none;
    }
    .logo img {
      height: 42px;
    }
  }
  @media (max-width: 400px) {
    .phone span {
      display: none;
    }
  }
</style>
