---
// Paginahero met één reuzenwoord (zelfde systeem als de homepage), als donker vlak dat "achter" ligt.
// Gebruik binnen een <div class="paar">, gevolgd door een licht paneel.
interface Props {
  woord: string;
  kleur?: 'koud' | 'warm' | 'wit';
  eyebrow: string;
  titel?: string;
  tekst: string;
  temp?: { buiten: number; binnen: number };
  /** Breedte van het woord t.o.v. het infoblok */
  verhouding?: 'breed' | 'smal';
}
const { woord, kleur = 'wit', eyebrow, titel, tekst, temp, verhouding = 'breed' } = Astro.props;
const graden = (t: number) => `${t < 0 ? '−' : ''}${Math.abs(t)}°`;
---

<div class="vlak donker plak" data-diepte-vlak data-geen-mobiele-cta>
  <div class="vlak-inhoud">
    <section class:list={['rhero', kleur, verhouding]}>
      <div class="glow" aria-hidden="true"></div>
      <div class="raster">
        <p class="woord" aria-hidden="true">{woord}</p>
        <div class="info">
          <slot name="beeld" />
          <p class:list={['eyebrow', { cold: kleur === 'koud' }]}>{eyebrow}</p>
          <h1 class:list={{ 'sr-only': !titel, titel: !!titel }}>{titel ?? woord}</h1>
          <p class="tekst">{tekst}</p>
          <div class="actions"><slot /></div>
        </div>
      </div>
      {
        temp && (
          <div class="temp" aria-label={`Buiten ${graden(temp.buiten)}, binnen ${graden(temp.binnen)}`}>
            <span class="lbl">Buiten</span>
            <b class:list={['g', temp.buiten > 15 ? 'o' : 'b']}>{graden(temp.buiten)}</b>
            <span class="balk" aria-hidden="true" />
            <span class="lbl">Binnen</span>
            <b class:list={['g', kleur === 'warm' ? 'o' : 'b']}>{graden(temp.binnen)}</b>
          </div>
        )
      }
    </section>
  </div>
</div>

<style>
  .rhero {
    position: relative;
    overflow: hidden;
    padding: calc(var(--header-h) + clamp(28px, 5vw, 72px)) clamp(16px, 3vw, 36px) clamp(48px, 6vw, 84px);
  }
  .glow {
    background: radial-gradient(50% 60% at 22% 35%, rgb(66 125 184 / 0.42), transparent 70%),
      radial-gradient(40% 50% at 90% 90%, rgb(234 91 12 / 0.18), transparent 70%);
  }
  .warm .glow {
    background: radial-gradient(50% 60% at 28% 65%, rgb(234 91 12 / 0.42), transparent 70%),
      radial-gradient(40% 50% at 85% 10%, rgb(66 125 184 / 0.18), transparent 70%);
  }
  .wit .glow {
    background: radial-gradient(45% 50% at 20% 30%, rgb(66 125 184 / 0.32), transparent 70%),
      radial-gradient(45% 50% at 40% 85%, rgb(234 91 12 / 0.28), transparent 70%);
  }
  .raster {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    gap: 32px;
    align-items: end;
  }
  .smal .raster {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }
  .woord {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 115%;
    font-weight: 800;
    font-size: clamp(4.2rem, 15vw, 15rem);
    line-height: 0.84;
    letter-spacing: -0.06em;
    color: var(--text-on-dark);
    overflow-wrap: anywhere;
  }
  .smal .woord {
    font-size: clamp(3.2rem, 7vw, 7.5rem);
  }
  .koud .woord {
    background: linear-gradient(100deg, #e9f3fc 10%, #8fc1f0 45%, #3a74b0 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .warm .woord {
    background: linear-gradient(100deg, #fff1e6 10%, #ff7a2f 45%, #c2410c 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .info {
    padding-bottom: 10px;
  }
  .titel {
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    margin: 0 0 10px;
  }
  .tekst {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    line-height: 1.38;
    letter-spacing: -0.01em;
    margin: 0 0 24px;
  }
  .temp {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: clamp(28px, 4vw, 48px);
  }
  .lbl {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-on-dark);
  }
  .g {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    letter-spacing: -0.03em;
  }
  .g.b {
    color: var(--blue-ice);
  }
  .g.o {
    color: var(--orange-hot);
  }
  .balk {
    flex: 1;
    height: 6px;
    border-radius: 6px;
    background: linear-gradient(90deg, var(--orange-hot), var(--blue-ice));
  }
  .warm .balk {
    background: linear-gradient(90deg, var(--blue-ice), var(--orange-hot));
  }
  @media (max-width: 860px) {
    .raster,
    .smal .raster {
      grid-template-columns: minmax(0, 1fr);
    }
    .temp {
      gap: 10px;
    }
  }
</style>
