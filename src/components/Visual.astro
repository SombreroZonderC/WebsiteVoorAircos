---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Toont een foto als die er is, anders een technische lijntekening als
// placeholder met een label dat aangeeft welke foto er nog moet komen.

interface Props {
  soort: 'airco' | 'warmtepomp' | 'onderhoud' | 'portret';
  foto?: ImageMetadata;
  alt?: string;
  /** Wat voor foto hier straks moet komen */
  label?: string;
  sfeerbeeld?: boolean;
  verhouding?: string;
  eager?: boolean;
  class?: string;
}

const {
  soort,
  foto,
  alt = '',
  label,
  sfeerbeeld = false,
  verhouding = '4 / 3',
  eager = false,
  class: className,
} = Astro.props;

const accent = soort === 'warmtepomp' ? 'warm' : 'koud';
---

<figure class:list={['visual', accent, className, { 'has-photo': foto }]} style={`aspect-ratio: ${verhouding}`}>
  {
    foto ? (
      <>
        <Image
          src={foto}
          alt={alt}
          widths={[480, 800, 1200, 1600]}
          sizes="(max-width: 720px) 100vw, 50vw"
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
        />
        {sfeerbeeld && <figcaption class="tag">Sfeerbeeld</figcaption>}
      </>
    ) : (
      <>
        <div class="grid" aria-hidden="true" />
        <svg class="drawing" viewBox="0 0 400 300" aria-hidden="true">
          {soort === 'airco' && (
            <g>
              <rect x="70" y="80" width="260" height="78" rx="18" />
              <path d="M90 136h220" />
              <path d="M104 146h192" class="thin" />
              <circle cx="300" cy="104" r="4" class="dot" />
              <path class="flow" d="M120 180c10 18 -10 30 0 50M170 180c10 18 -10 30 0 50M220 180c10 18 -10 30 0 50M270 180c10 18 -10 30 0 50" />
            </g>
          )}
          {soort === 'warmtepomp' && (
            <g>
              <rect x="90" y="70" width="220" height="160" rx="10" />
              <circle cx="180" cy="150" r="56" />
              <circle cx="180" cy="150" r="10" class="dot" />
              <path class="thin" d="M180 94v112M124 150h112M140 110l80 80M220 110l-80 80" />
              <path d="M258 96h30M258 112h30M258 128h30" class="thin" />
              <path d="M110 230v14M290 230v14" />
              <path class="flow" d="M330 120c14 10 -14 20 0 30M346 120c14 10 -14 20 0 30" />
            </g>
          )}
          {soort === 'onderhoud' && (
            <g>
              <circle cx="170" cy="150" r="72" />
              <circle cx="170" cy="150" r="58" class="thin" />
              <path class="thin" d="M122 182l8-6M118 150h10M122 118l8 6M170 92v10M218 118l-8 6M222 150h-10" />
              <path d="M170 150l34-30" />
              <circle cx="170" cy="150" r="7" class="dot" />
              <path d="M170 222v26h90" />
              <path class="flow" d="M276 92l38-38a22 22 0 0 1 22 30l-10 10-12-12-10 10 12 12-10 10a22 22 0 0 1-30-22z" />
            </g>
          )}
          {soort === 'portret' && (
            <g>
              <circle cx="200" cy="120" r="44" />
              <path d="M110 250c8-50 46-78 90-78s82 28 90 78" />
              <path class="flow" d="M130 70l14 14M270 70l-14 14" />
            </g>
          )}
        </svg>
        {label && <figcaption class="tag">Foto volgt · {label}</figcaption>}
      </>
    )
  }
</figure>

<style>
  .visual {
    --c: var(--blue-ice);
    position: relative;
    margin: 0;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-dark);
    background:
      radial-gradient(70% 60% at 30% 20%, rgb(66 125 184 / 0.22), transparent 70%),
      linear-gradient(160deg, var(--ink-3), var(--ink));
    isolation: isolate;
  }
  .visual.warm {
    --c: var(--orange-hot);
    background:
      radial-gradient(70% 60% at 70% 80%, rgb(234 91 12 / 0.22), transparent 70%),
      linear-gradient(160deg, var(--ink-3), var(--ink));
  }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.06) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(80% 80% at 50% 50%, #000 30%, transparent 85%);
  }
  .drawing {
    position: absolute;
    inset: 8% 10%;
    width: 80%;
    height: 84%;
    fill: none;
    stroke: rgb(232 240 243 / 0.85);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .drawing .thin {
    stroke-width: 1.4;
    opacity: 0.55;
  }
  .drawing .dot {
    fill: var(--c);
    stroke: none;
  }
  .drawing .flow {
    stroke: var(--c);
    stroke-dasharray: 6 8;
    animation: flow 2.8s linear infinite;
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -56;
    }
  }
  .visual :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .has-photo {
    border-color: transparent;
  }
  .tag {
    position: absolute;
    left: 14px;
    bottom: 14px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgb(6 20 25 / 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--line-dark);
    color: var(--text-on-dark);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
</style>
