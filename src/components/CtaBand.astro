---
import Icon from './Icon.astro';
import { bedrijf, home, mailLink, telLink } from '../lib/bedrijf';

interface Props {
  titel?: string;
  tekst?: string;
}
const { titel = home.cta.titel, tekst = home.cta.tekst } = Astro.props;
---

<section class="finale dark" aria-label="Contact" data-geen-mobiele-cta>
  <p class="pre">{titel}</p>
  <a class="giant" href={telLink}>Bel Sjoerd <span aria-hidden="true">→</span></a>
  <a class="nummer" href={telLink}><Icon name="phone" size={20} /> {bedrijf.telefoon.weergave}</a>
  <p class="tekst">{tekst}</p>
  <div class="actions">
    <a class="btn ghost" href="/contact">Offerte aanvragen <Icon name="arrow" /></a>
    <a class="mail" href={mailLink}><Icon name="mail" size={18} /> {bedrijf.email}</a>
  </div>
</section>

<style>
  .finale {
    position: relative;
    z-index: 3;
    display: grid;
    justify-items: center;
    text-align: center;
    padding: clamp(96px, 13vw, 170px) 16px;
    /* Eén warme spotlight achter "Bel Sjoerd": dat is hier het enige focal point */
    background:
      radial-gradient(38% 34% at 50% 36%, rgb(234 91 12 / 0.24), transparent 72%),
      var(--ink);
    border-top: 1px solid var(--line-dark);
  }
  .pre {
    color: var(--muted-on-dark);
    font-size: 1.15rem;
    margin: 0 0 8px;
  }
  .giant {
    display: inline-flex;
    gap: 0.25em;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: clamp(3rem, 10vw, 9rem);
    letter-spacing: -0.05em;
    line-height: 1.1;
    padding-bottom: 0.08em;
    text-decoration: none;
    color: var(--text-on-dark);
  }
  .giant span {
    color: var(--orange-hot);
    transition: transform 0.3s var(--ease);
  }
  .giant:hover span {
    transform: translateX(14px);
  }
  .tekst {
    color: var(--muted-on-dark);
    max-width: 52ch;
    margin: 8px 0 28px;
  }
  .actions {
    justify-content: center;
    align-items: center;
    gap: 20px 28px;
  }
  .nummer {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 4px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    letter-spacing: -0.01em;
    color: var(--muted-on-dark);
    text-decoration: none;
  }
  .nummer :global(svg) {
    color: var(--orange-hot);
  }
  .mail {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted-on-dark);
    text-underline-offset: 4px;
  }
  .mail:hover {
    color: var(--text-on-dark);
  }
</style>
