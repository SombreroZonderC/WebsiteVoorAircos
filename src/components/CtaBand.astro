---
import Icon from './Icon.astro';
import { bedrijf, home, mailLink, telLink } from '../lib/bedrijf';

interface Props {
  titel?: string;
  tekst?: string;
}
const { titel = home.cta.titel, tekst = home.cta.tekst } = Astro.props;
---

<section class="finale dark" aria-label="Contact" data-geen-mobiele-cta>
  <p class="pre">{titel}</p>
  <a class="giant" href={telLink}>Bel Sjoerd <span aria-hidden="true">→</span></a>
  <p class="tekst">{tekst}</p>
  <div class="actions">
    <a class="btn" href="/contact">Offerte aanvragen <Icon name="arrow" /></a>
    <a class="btn ghost" href={mailLink}><Icon name="mail" /> {bedrijf.email}</a>
  </div>
  <p class="nummer">{bedrijf.telefoon.weergave}</p>
</section>

<style>
  .finale {
    position: relative;
    z-index: 3;
    display: grid;
    justify-items: center;
    text-align: center;
    padding: clamp(96px, 13vw, 170px) 16px;
    background:
      radial-gradient(40% 60% at 35% 100%, rgb(66 125 184 / 0.3), transparent 70%),
      radial-gradient(40% 60% at 65% 100%, rgb(234 91 12 / 0.3), transparent 70%),
      var(--ink);
    border-top: 1px solid var(--line-dark);
  }
  .pre {
    color: var(--muted-on-dark);
    font-size: 1.15rem;
    margin: 0 0 8px;
  }
  .giant {
    display: inline-flex;
    gap: 0.25em;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: clamp(3rem, 10vw, 9rem);
    letter-spacing: -0.05em;
    line-height: 1.1;
    padding-bottom: 0.08em;
    text-decoration: none;
    color: var(--text-on-dark);
  }
  .giant span {
    color: var(--orange-hot);
    transition: transform 0.3s var(--ease);
  }
  .giant:hover span {
    transform: translateX(14px);
  }
  .tekst {
    color: var(--muted-on-dark);
    max-width: 52ch;
    margin: 8px 0 28px;
  }
  .actions {
    justify-content: center;
  }
  .nummer {
    font-family: var(--font-mono);
    color: var(--muted-on-dark);
    margin: 24px 0 0;
  }
</style>
