---
// Kaarten per ruimte of systeem, met optionele prijsindicatie en link (homepage en airco-pagina).
import Icon from './Icon.astro';

interface Props {
  ruimtes: { titel: string; tekst: string; prijsVanaf: string | null }[];
  soort: string;
  href?: string;
  metPrijs?: boolean;
  accent?: 'koud' | 'warm' | 'auto';
}
const { ruimtes, soort, href, metPrijs = true, accent = 'auto' } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<div class:list={['ruimtes', accent]}>
  {
    ruimtes.map((r) => (
      <Tag class:list={['ruimte', { link: href }]} href={href}>
        <span class="soort">{soort}</span>
        <h3>{r.titel}</h3>
        <p>{r.tekst}</p>
        {(metPrijs || href) && (
          <span class="voet">
            {metPrijs &&
              (r.prijsVanaf ? (
                <span>
                  Indicatie vanaf <b>{r.prijsVanaf}</b>
                </span>
              ) : (
                <span class="todo">prijsindicatie</span>
              ))}
            {href && <Icon name="arrow" size={18} />}
          </span>
        )}
      </Tag>
    ))
  }
</div>

<style>
  .ruimtes {
    --a: var(--accent, var(--blue-text));
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .ruimtes.koud {
    --a: var(--blue-text);
  }
  .ruimtes.warm {
    --a: var(--orange-text);
  }
  .ruimte {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--paper-2);
    border: 1px solid var(--line);
    text-decoration: none;
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }
  .ruimte.link:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 40px -26px rgb(12 29 35 / 0.4);
  }
  .soort {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--a);
  }
  h3 {
    margin: 0;
  }
  p {
    margin: 0;
    color: var(--muted);
    flex: 1;
  }
  .voet {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 0.88rem;
    color: var(--muted);
  }
  .voet :global(svg) {
    color: var(--a);
    flex: none;
    margin-left: auto;
  }
  @media (max-width: 860px) {
    .ruimtes {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
