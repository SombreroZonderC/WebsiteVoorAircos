---
import Icon from './Icon.astro';
import { bedrijf, mailLink, nav, telLink } from '../lib/bedrijf';

const year = new Date().getFullYear();
---

<footer class="footer dark">
  <div class="wrap">
    <div class="top">
      <div class="brand">
        <img src="/images/logo-op-donker.svg" alt={bedrijf.naam} width="170" height="94" loading="lazy" />
        <p class="muted">
          Vakmanschap en betrouwbare service, rechtstreeks vanuit Heeten. Specialist in {bedrijf.merk}.
        </p>
      </div>

      <div>
        <h2 class="h">Menu</h2>
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
          <li><a href="/contact">Contact & offerte</a></li>
        </ul>
      </div>

      <div>
        <h2 class="h">Contact</h2>
        <ul class="contact">
          <li>
            <Icon name="phone" size={18} /><a href={telLink}>{bedrijf.telefoon.weergave}</a>
          </li>
          <li>
            <Icon name="mail" size={18} /><a href={mailLink}>{bedrijf.email}</a>
          </li>
          <li>
            <Icon name="pin" size={18} />
            <span>
              {bedrijf.adres.straat}<br />{bedrijf.adres.postcode} {bedrijf.adres.plaats}
            </span>
          </li>
          {
            bedrijf.openingstijden && (
              <li>
                <Icon name="clock" size={18} />
                <span>{bedrijf.openingstijden}</span>
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <div class="bottom">
      <span>© {year} {bedrijf.naam}</span>
      {bedrijf.kvk && <span>KvK {bedrijf.kvk}</span>}
      {bedrijf.btw && <span>Btw {bedrijf.btw}</span>}
      <a href="/privacy">Privacyverklaring</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 80px 32px;
    border-top: 1px solid var(--line-dark);
  }
  .top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr;
    gap: 48px;
  }
  .brand img {
    width: 170px;
    height: auto;
    margin-bottom: 20px;
  }
  .brand p {
    max-width: 34ch;
    font-size: 0.95rem;
  }
  .h {
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-on-dark);
    margin-bottom: 18px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  a {
    text-decoration: none;
    color: var(--text-on-dark);
  }
  a:hover {
    color: var(--orange);
  }
  .contact li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 12px;
    align-items: start;
  }
  .contact svg {
    color: var(--orange);
    margin-top: 4px;
  }
  .bottom {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--line-dark);
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-size: 0.85rem;
    color: var(--muted-on-dark);
  }
  .bottom a {
    color: var(--muted-on-dark);
  }
  @media (max-width: 820px) {
    .top {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
