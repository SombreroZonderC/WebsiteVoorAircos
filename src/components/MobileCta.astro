---
import Icon from './Icon.astro';
import { bedrijf, telLink, whatsappLink } from '../lib/bedrijf';
---

<nav class="mobile-cta" aria-label="Snel contact">
  <a href={telLink} class="call">
    <Icon name="phone" size={18} /> Bellen
  </a>
  {
    bedrijf.whatsapp ? (
      <a href={whatsappLink} class="alt">
        <Icon name="whatsapp" size={18} /> WhatsApp
      </a>
    ) : (
      <a href="/contact" class="alt">
        <Icon name="chat" size={18} /> Offerte
      </a>
    )
  }
</nav>

<script>
  // Verbergen zolang er al een grote belknop in beeld is (hero, "Bel Sjoerd"-afsluiter).
  const balk = document.querySelector<HTMLElement>('.mobile-cta');
  const plekken = document.querySelectorAll('[data-geen-mobiele-cta]');
  if (balk && plekken.length && 'IntersectionObserver' in window) {
    const zichtbaar = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? zichtbaar.add(e.target) : zichtbaar.delete(e.target)));
      balk.classList.toggle('weg', zichtbaar.size > 0);
    });
    plekken.forEach((p) => io.observe(p));
  }
</script>

<style>
  .mobile-cta {
    display: none;
  }
  @media (max-width: 720px) {
    .mobile-cta {
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: max(12px, env(safe-area-inset-bottom));
      z-index: 40;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      padding: 8px;
      border-radius: 18px;
      background: rgb(5 9 11 / 0.9);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid var(--line-dark);
      box-shadow: 0 16px 40px -12px rgb(0 0 0 / 0.5);
      transition:
        transform 0.3s var(--ease),
        opacity 0.3s var(--ease);
    }
    .mobile-cta.weg {
      transform: translateY(calc(100% + 24px));
      opacity: 0;
      pointer-events: none;
    }
    .mobile-cta a {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 48px;
      border-radius: 12px;
      text-decoration: none;
      font-family: var(--font-display);
      font-stretch: 108%;
      font-weight: 700;
      color: #fff;
    }
    .call {
      background: var(--orange-btn);
    }
    .alt {
      background: rgb(255 255 255 / 0.08);
    }
    /* Ruimte onder de footer zodat de balk niets afdekt */
    :global(footer.footer) {
      padding-bottom: calc(110px + env(safe-area-inset-bottom));
    }
  }
</style>
