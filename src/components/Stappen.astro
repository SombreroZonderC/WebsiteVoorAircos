---
interface Props {
  stappen: { titel: string; tekst: string }[];
}
const { stappen } = Astro.props;
---

<ol class="stappen">
  {
    stappen.map((s, i) => (
      <li data-reveal style={`transition-delay: ${i * 70}ms`}>
        <span class="nr">{String(i + 1).padStart(2, '0')}</span>
        <h3>{s.titel}</h3>
        <p>{s.tekst}</p>
      </li>
    ))
  }
</ol>

<style>
  .stappen {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 0;
    border-top: 1px solid var(--line);
  }
  :global(.dark) .stappen {
    border-color: var(--line-dark);
  }
  li {
    padding: 28px 24px 8px 0;
    position: relative;
  }
  li::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 40px;
    height: 2px;
    background: var(--orange);
  }
  .nr {
    display: block;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: 0.9rem;
    color: var(--orange);
    margin-bottom: 14px;
    letter-spacing: 0.06em;
  }
  h3 {
    margin-bottom: 8px;
  }
  p {
    color: var(--muted);
    font-size: 0.98rem;
  }
  :global(.dark) p {
    color: var(--muted-on-dark);
  }
</style>
