---
// Warmtepomp: drie klikvragen die een eerlijke eerste richting geven (geen belofte, wel een startpunt).
import Icon from './Icon.astro';

const vragen = [
  { id: 'isolatie', label: 'Hoe is je huis geïsoleerd?', opties: [['goed', 'Goed'], ['matig', 'Matig'], ['weet', 'Weet ik niet']] },
  { id: 'afgifte', label: 'Hoe verwarm je nu?', opties: [['vloer', 'Vloerverwarming'], ['radiatoren', 'Radiatoren'], ['beide', 'Allebei']] },
  { id: 'buiten', label: 'Is er ruimte voor een buitenunit?', opties: [['ja', 'Ja'], ['weet', 'Weet ik niet']] },
] as const;
---

<form class="check" data-check aria-labelledby="check-titel">
  <p class="eyebrow">Is mijn huis geschikt?</p>
  <h2 id="check-titel">Drie vragen, een eerste richting.</h2>
  <div class="vragen">
    {
      vragen.map((v) => (
        <fieldset class="vraag">
          <legend>{v.label}</legend>
          <div class="keuzes">
            {v.opties.map(([waarde, label], i) => (
              <label>
                <input type="radio" name={v.id} value={waarde} checked={i === 1 || (v.id === 'buiten' && i === 0)} />
                <span>{label}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))
    }
  </div>
  <output class="uitkomst" data-uitkomst aria-live="polite">
    <span class="eyebrow">Eerste richting</span>
    <b data-richting>Een hybride warmtepomp is waarschijnlijk een goede start.</b>
    <span class="muted" data-toelichting>Hij werkt samen met je cv-ketel en past ook in huizen die nog niet perfect geïsoleerd zijn.</span>
  </output>
  <div class="actions">
    <a class="btn" href="/contact?onderwerp=warmtepompen">Plan advies aan huis <Icon name="arrow" /></a>
  </div>
  <p class="klein muted">Dit is een algemene indicatie. Wat echt past, bekijk ik bij je thuis.</p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-check]').forEach((form) => {
    const richting = form.querySelector<HTMLElement>('[data-richting]')!;
    const toelichting = form.querySelector<HTMLElement>('[data-toelichting]')!;
    const update = () => {
      const d = new FormData(form);
      const isolatie = d.get('isolatie');
      const afgifte = d.get('afgifte');
      const buiten = d.get('buiten');
      let r = 'Een hybride warmtepomp is waarschijnlijk een goede start.';
      let t = 'Hij werkt samen met je cv-ketel en past ook in huizen die nog niet perfect geïsoleerd zijn.';
      if (isolatie === 'goed' && afgifte !== 'radiatoren') {
        r = 'All-electric kan goed bij je huis passen.';
        t = 'Met goede isolatie en (deels) vloerverwarming kun je mogelijk helemaal van het gas af.';
      } else if (isolatie === 'goed') {
        r = 'Hybride of all-electric: allebei het bekijken waard.';
        t = 'Met goede isolatie kan all-electric, maar het hangt af van je radiatoren.';
      }
      if (buiten === 'weet') t += ' Waar de buitenunit kan staan, bekijk ik ter plekke.';
      richting.textContent = r;
      toelichting.textContent = t;
    };
    form.addEventListener('change', update);
    form.addEventListener('submit', (e) => e.preventDefault());
    update();
  });
</script>

<style>
  h2 {
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    letter-spacing: -0.04em;
    margin-bottom: 22px;
  }
  .vragen {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .vraag {
    margin: 0;
    padding: 18px;
    border-radius: 18px;
    background: var(--paper-2);
    border: 1px solid var(--line);
  }
  legend {
    float: left;
    width: 100%;
    font-weight: 700;
    margin-bottom: 12px;
  }
  .keuzes {
    clear: both;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .keuzes label {
    position: relative;
    cursor: pointer;
  }
  .keuzes input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .keuzes span {
    display: inline-block;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-weight: 600;
    font-size: 0.92rem;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .keuzes input:checked + span {
    background: var(--orange-text);
    border-color: var(--orange-text);
    color: #fff;
  }
  .keuzes input:focus-visible + span {
    outline: 3px solid var(--orange);
    outline-offset: 2px;
  }
  .uitkomst {
    display: grid;
    gap: 4px;
    margin: 14px 0 18px;
    padding: 20px 22px;
    border-radius: 18px;
    background: var(--paper-2);
    border: 1.5px solid var(--orange-text);
  }
  .uitkomst .eyebrow {
    margin: 0;
  }
  .uitkomst b {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    letter-spacing: -0.02em;
  }
  .klein {
    font-size: 0.85rem;
    margin-top: 10px;
  }
  @media (max-width: 860px) {
    .vragen {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
