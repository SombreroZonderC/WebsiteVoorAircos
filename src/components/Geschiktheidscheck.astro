---
// Warmtepomp: drie klikvragen die een eerlijke eerste richting geven (geen belofte, wel een startpunt).
import Icon from './Icon.astro';

import { warmtepomp } from '../lib/inhoud';

// De vraag-ids en waarden zijn vast (de logica hangt ervan af); de teksten komen uit warmtepompen.json.
const c = warmtepomp.check;
const v = c.vragen;
const vragen = [
  { id: 'isolatie', label: v.isolatie.label, opties: [['goed', v.isolatie.goed], ['matig', v.isolatie.matig], ['weet', v.isolatie.weet]] },
  { id: 'afgifte', label: v.afgifte.label, opties: [['vloer', v.afgifte.vloer], ['radiatoren', v.afgifte.radiatoren], ['beide', v.afgifte.beide]] },
  { id: 'buiten', label: v.buiten.label, opties: [['ja', v.buiten.ja], ['weet', v.buiten.weet]] },
] as const;
---

<form class="check" data-check data-uitkomsten={JSON.stringify(c.uitkomsten)} aria-labelledby="check-titel">
  <p class="eyebrow">{c.eyebrow}</p>
  <h2 id="check-titel">{c.titel}</h2>
  <div class="vragen">
    {
      vragen.map((v) => (
        <fieldset class="vraag">
          <legend>{v.label}</legend>
          <div class="keuzes">
            {v.opties.map(([waarde, label], i) => (
              <label>
                <input type="radio" name={v.id} value={waarde} checked={i === 1 || (v.id === 'buiten' && i === 0)} />
                <span>{label}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))
    }
  </div>
  <output class="uitkomst" data-uitkomst aria-live="polite">
    <span class="eyebrow">Eerste richting</span>
    <b data-richting>{c.uitkomsten.hybride.richting}</b>
    <span class="muted" data-toelichting>{c.uitkomsten.hybride.toelichting}</span>
  </output>
  <div class="actions">
    <a class="btn" href="/contact?onderwerp=warmtepompen">{c.cta} <Icon name="arrow" /></a>
  </div>
  <p class="klein muted">{c.disclaimer}</p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-check]').forEach((form) => {
    const richting = form.querySelector<HTMLElement>('[data-richting]')!;
    const toelichting = form.querySelector<HTMLElement>('[data-toelichting]')!;
    const u = JSON.parse(form.dataset.uitkomsten!);
    const update = () => {
      const d = new FormData(form);
      const isolatie = d.get('isolatie');
      const afgifte = d.get('afgifte');
      let keuze = u.hybride;
      if (isolatie === 'goed' && afgifte !== 'radiatoren') keuze = u.electric;
      else if (isolatie === 'goed') keuze = u.beide;
      richting.textContent = keuze.richting;
      toelichting.textContent = d.get('buiten') === 'weet' ? `${keuze.toelichting} ${u.buitenOnbekend}` : keuze.toelichting;
    };
    form.addEventListener('change', update);
    form.addEventListener('submit', (e) => e.preventDefault());
    update();
  });
</script>

<style>
  h2 {
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    letter-spacing: -0.04em;
    margin-bottom: 22px;
  }
  .vragen {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .vraag {
    margin: 0;
    padding: 18px;
    border-radius: var(--radius-lg);
    background: var(--paper-2);
    border: 1px solid var(--line);
  }
  legend {
    float: left;
    width: 100%;
    font-weight: 700;
    margin-bottom: 12px;
  }
  .keuzes {
    clear: both;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .keuzes label {
    position: relative;
    cursor: pointer;
  }
  .keuzes input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .keuzes span {
    display: inline-block;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-weight: 600;
    font-size: 0.92rem;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .keuzes input:checked + span {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  .keuzes input:focus-visible + span {
    outline: 3px solid var(--orange);
    outline-offset: 2px;
  }
  .uitkomst {
    display: grid;
    gap: 4px;
    margin: 14px 0 18px;
    padding: 20px 22px;
    border-radius: var(--radius-lg);
    background: var(--ink);
    color: var(--text-on-dark);
    border: 0;
    border-left: 4px solid var(--orange-hot);
  }
  .uitkomst .eyebrow {
    margin: 0;
    color: var(--muted-on-dark);
  }
  .uitkomst .muted {
    color: var(--muted-on-dark);
  }
  .uitkomst b {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    letter-spacing: -0.02em;
  }
  .klein {
    font-size: 0.85rem;
    margin-top: 10px;
  }
  @media (max-width: 860px) {
    .vragen {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
