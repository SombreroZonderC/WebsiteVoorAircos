---
// Gestileerde technische tekening van een binnen- of buitenunit, met labels.
interface Props {
  soort: 'buiten' | 'binnen';
  labels: { letter: string; tekst: string; x: number; y: number }[];
  kleur?: string;
}
const { soort, labels, kleur = '#7fb4ea' } = Astro.props;
---

<figure class="tt" style={`--c:${kleur}`}>
  <svg viewBox="0 0 560 420" role="img" aria-label={soort === 'buiten' ? 'Opengewerkte buitenunit' : 'Opengewerkte binnenunit'}>
    {
      soort === 'buiten' ? (
        <g>
          <path class="d" d="M150 110 L390 70 L470 120 L470 340 L230 380 L150 330 Z" />
          <path class="d thin" d="M230 160 L470 120 M230 160 L230 380 M230 160 L150 110" />
          <g transform="translate(-60 40)">
            <path class="d panel" d="M150 130 L390 90 L390 310 L150 350 Z" />
            <g class="fan">
              <circle class="d" cx="268" cy="222" r="78" />
              <circle class="d thin" cx="268" cy="222" r="62" />
              <path class="d thin" d="M268 160 V284 M206 222 H330 M224 178 L312 266 M312 178 L224 266" />
              <circle cx="268" cy="222" r="9" class="hub" />
            </g>
          </g>
          <path class="d" d="M160 400 L240 412 L480 372" />
        </g>
      ) : (
        <g>
          <path class="d thin" d="M40 70 H520 M40 70 V400" />
          <path class="d thin" d="M96 100 H464" />
          <path class="d panel" d="M80 112 Q80 96 96 96 L464 96 Q480 96 480 112 L480 196 Q480 226 450 230 L110 230 Q80 226 80 196 Z" />
          <path class="d thin" d="M96 120 H464 M96 132 H464 M96 144 H464" />
          <path class="d" d="M104 212 Q280 238 456 212" />
          <path class="d thin" d="M112 222 Q280 246 448 222" />
          <rect class="d thin" x="398" y="160" width="46" height="16" rx="4" />
          <circle cx="408" cy="168" r="3.5" class="hub" />
          <path class="d" d="M480 170 H500 Q510 170 510 180 V400" />
          <path class="d thin" d="M488 182 H496 Q500 182 500 186 V400" />
          <path class="d flow" d="M150 262 c12 22 -12 38 0 62 M230 266 c12 22 -12 38 0 62 M310 266 c12 22 -12 38 0 62 M390 262 c12 22 -12 38 0 62" />
          <rect class="d panel" x="96" y="300" width="34" height="76" rx="8" />
          <rect class="d thin" x="104" y="310" width="18" height="14" rx="2" />
          <circle cx="113" cy="344" r="5" class="d thin" />
          <circle cx="113" cy="362" r="3" class="hub" />
        </g>
      )
    }
  </svg>
  {
    labels.map((l) => (
      <span class="lbl" style={`left:${l.x}%; top:${l.y}%`}>
        <b>{l.letter}</b>
        {l.tekst}
      </span>
    ))
  }
</figure>

<style>
  .tt {
    position: relative;
    margin: 0;
  }
  svg {
    width: 100%;
    height: auto;
    fill: none;
    stroke: rgb(232 240 243 / 0.85);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .thin {
    stroke-width: 1;
    opacity: 0.5;
  }
  .panel {
    fill: rgb(10 20 26 / 0.9);
  }
  .hub {
    fill: var(--c);
    stroke: none;
  }
  .flow {
    stroke: var(--c);
    stroke-dasharray: 6 8;
    animation: tt-flow 2.4s linear infinite;
  }
  .fan {
    transform-origin: 268px 222px;
    transform-box: view-box;
    animation: tt-spin 7s linear infinite;
  }
  @keyframes tt-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes tt-flow {
    to {
      stroke-dashoffset: -56;
    }
  }
  .lbl {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px 7px 7px;
    border-radius: 999px;
    background: rgb(6 14 18 / 0.85);
    border: 1px solid rgb(255 255 255 / 0.14);
    backdrop-filter: blur(6px);
    color: #e8f0f3;
    font: 500 0.82rem/1.2 'IBM Plex Mono', ui-monospace, monospace;
    white-space: nowrap;
  }
  .lbl b {
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--c);
    color: #061419;
    font-size: 0.72rem;
  }
  @media (max-width: 700px) {
    .lbl {
      position: static;
      display: flex;
      margin-top: 8px;
      white-space: normal;
    }
  }
</style>
