---
// PROTOTYPE ronde 3 – C "Mix": donkere hero, lichte body; thermometer loopt mee met het scrollen langs de werkwijze.
import { getCollection } from 'astro:content';
import { bedrijf, telLink } from '../../lib/bedrijf';
import R3Hero from './R3Hero.astro';
import Thermometer from './Thermometer.astro';
import TechTekening from './TechTekening.astro';

const reviews = (await getCollection('reviews')).slice(0, 3);
const stappen = [
  { t: 'Je belt of mailt', p: 'Je vertelt kort wat je zoekt. Koelen, verwarmen, of allebei.' },
  { t: 'Ik kom langs', p: 'Advies aan huis: ik kijk naar de ruimtes, de isolatie en de beste plek voor de units.' },
  { t: 'Heldere offerte', p: 'Vrijblijvend en duidelijk. Je weet precies wat je krijgt.' },
  { t: 'Nette installatie', p: 'Strak geplaatst, getest en opgeruimd. Ik leg uit hoe alles werkt.' },
  { t: '21°. Het hele jaar.', p: 'En daarna blijf ik je aanspreekpunt voor onderhoud.' },
];
---

<div class="r3c">
  <R3Hero thema="donker" />

  <div class="trust">
    <span class="ph">★ Google-score volgt</span>
    <span><b>{bedrijf.jarenErvaring}</b> jaar ervaring</span>
    <span>Specialist <b>{bedrijf.merk}</b></span>
    <span>Gevestigd in <b>{bedrijf.adres.plaats}</b></span>
  </div>

  <section class="reis" data-reis>
    <div class="wrap reis-grid">
      <div class="sticky">
        <p class="eyebrow mono">Van eerste belletje tot 21°</p>
        <Thermometer id="c-reis" label="Binnen" temp={-4} thema="licht" />
      </div>
      <ol class="stappen">
        {
          stappen.map((s, i) => (
            <li data-stap={i}>
              <span class="nr mono">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.t}</h3>
              <p>{s.p}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="diensten">
    <div class="wrap">
      <p class="eyebrow mono">Wat ik doe</p>
      <h2>Koelen of verwarmen. Of allebei.</h2>
      <div class="d-grid">
        <a class="dienst" href="#">
          <div class="vis koel">
            <TechTekening soort="binnen" kleur="#7fb4ea" labels={[{ letter: 'A', tekst: 'Fluisterstil', x: 4, y: 6 }]} />
          </div>
          <div class="body">
            <span class="soort mono koel">Airconditioning</span>
            <h3>Een koel huis, zonder herrie.</h3>
            <p>Koelt in de zomer, verwarmt zuinig in het voor- en najaar. Strak gemonteerd.</p>
            <span class="more">Meer over airco’s →</span>
          </div>
        </a>
        <a class="dienst" href="#">
          <div class="vis warm">
            <TechTekening soort="buiten" kleur="#ff7a2f" labels={[{ letter: 'A', tekst: 'Warmte uit buitenlucht', x: 0, y: 4 }]} />
          </div>
          <div class="body">
            <span class="soort mono warm">Warmtepomp</span>
            <h3>Warm, met veel minder gas.</h3>
            <p>Hybride naast je cv-ketel of volledig elektrisch. Eerlijk advies over wat past.</p>
            <span class="more">Meer over warmtepompen →</span>
          </div>
        </a>
      </div>
      <a class="onderhoud" href="#">
        <span><b>Onderhoud</b> · zuiniger, stiller en langer zorgeloos, ook na de installatie</span>
        <span>→</span>
      </a>
    </div>
  </section>

  <section class="reviews">
    <div class="wrap">
      <div class="rv-head">
        <div class="portret"><span class="mono">Foto Sjoerd volgt</span></div>
        <div>
          <p class="eyebrow mono">Je krijgt Sjoerd</p>
          <h2>Eén aanspreekpunt. Dat merken klanten.</h2>
        </div>
      </div>
      <div class="rv-grid">
        {
          reviews.map((r) => (
            <figure>
              <blockquote>“{r.data.tekst}”</blockquote>
              <figcaption>{r.data.naam} · Google</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="finale">
    <p class="muted">Benieuwd wat past bij jouw huis?</p>
    <a class="giant" href={telLink}>Bel Sjoerd <i>→</i></a>
    <p class="muted sub">{bedrijf.telefoon.weergave} · {bedrijf.email}</p>
  </section>
</div>

<script>
  const reis = document.querySelector<HTMLElement>('[data-reis]')!;
  const thermo = reis.querySelector<HTMLElement>('#c-reis')!;
  const waarde = thermo.querySelector<HTMLElement>('[data-waarde]')!;
  const stappen = [...reis.querySelectorAll<HTMLElement>('[data-stap]')];
  const update = () => {
    const r = reis.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, (innerHeight * 0.5 - r.top) / (r.height - innerHeight * 0.5)));
    const t = Math.round(-4 + p * 25);
    thermo.style.setProperty('--temp', String(t));
    waarde.textContent = `${t}°`;
    const actief = Math.min(stappen.length - 1, Math.floor(p * stappen.length));
    stappen.forEach((s, i) => s.classList.toggle('aan', i <= actief));
  };
  addEventListener('scroll', update, { passive: true });
  update();
</script>

<style>
  .r3c {
    --bg: #f5f6f4;
    --card: #fff;
    --ink: #0c1d23;
    --muted: #52666d;
    --line: rgb(12 29 35 / 0.1);
    --blue: #2a64a3;
    --orange: #b8460a;
    background: var(--bg);
    color: var(--ink);
  }
  .wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 40px);
  }
  .mono {
    font-family: 'IBM Plex Mono', monospace;
  }
  .trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 40px;
    padding: 20px 16px;
    background: #0b1418;
    color: #93a6ae;
    font-size: 0.95rem;
  }
  .trust b {
    color: #eef3f5;
  }
  .ph {
    color: #ffb27d;
    border: 1px dashed rgb(255 122 47 / 0.6);
    padding: 1px 9px;
    border-radius: 999px;
  }
  .eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--orange);
  }
  .r3c h2 {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: clamp(2.2rem, 4.4vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    margin: 0 0 40px;
  }

  .reis {
    padding: clamp(80px, 10vw, 120px) 0;
  }
  .reis-grid {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: clamp(32px, 6vw, 96px);
  }
  .sticky {
    position: sticky;
    top: 12vh;
    align-self: start;
    display: grid;
    justify-items: start;
    gap: 16px;
  }
  .sticky :global(.thermo) {
    margin-left: 20px;
  }
  .sticky :global(.kwik) {
    transition-duration: 0.3s;
  }
  .stappen {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .stappen li {
    min-height: 48vh;
    padding: 6vh 0;
    border-top: 1px solid var(--line);
    opacity: 0.3;
    transition: opacity 0.5s;
  }
  .stappen li.aan {
    opacity: 1;
  }
  .nr {
    color: var(--orange);
    font-size: 0.85rem;
  }
  .stappen h3 {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: clamp(2rem, 4vw, 3.4rem);
    letter-spacing: -0.04em;
    margin: 12px 0 12px;
  }
  .stappen p {
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 40ch;
    margin: 0;
  }

  .diensten,
  .reviews {
    padding: clamp(80px, 10vw, 130px) 0;
    border-top: 1px solid var(--line);
  }
  .d-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .dienst {
    display: flex;
    flex-direction: column;
    border-radius: 26px;
    background: var(--card);
    border: 1px solid var(--line);
    overflow: hidden;
    text-decoration: none;
    transition:
      transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.35s;
  }
  .dienst:hover {
    transform: translateY(-4px);
    box-shadow: 0 30px 60px -30px rgb(12 29 35 / 0.4);
  }
  .vis {
    padding: 32px 40px 24px;
    background: #071015;
  }
  .vis.koel {
    background: radial-gradient(70% 80% at 30% 20%, rgb(66 125 184 / 0.35), transparent 70%), #071015;
  }
  .vis.warm {
    background: radial-gradient(70% 80% at 70% 80%, rgb(234 91 12 / 0.3), transparent 70%), #071015;
  }
  .body {
    padding: 28px 32px 32px;
    display: grid;
    gap: 10px;
  }
  .soort {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .soort.koel {
    color: var(--blue);
  }
  .soort.warm {
    color: var(--orange);
  }
  .body h3 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    letter-spacing: -0.03em;
    margin: 0;
  }
  .body p {
    margin: 0;
    color: var(--muted);
  }
  .more {
    font-weight: 700;
    margin-top: 6px;
  }
  .onderhoud {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 16px;
    padding: 22px 32px;
    border-radius: 999px;
    background: var(--card);
    border: 1px solid var(--line);
    text-decoration: none;
    color: var(--muted);
  }
  .onderhoud b {
    color: var(--ink);
  }
  .rv-head {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 32px;
    align-items: center;
    margin-bottom: 48px;
  }
  .rv-head h2 {
    margin: 0;
  }
  .portret {
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px dashed rgb(12 29 35 / 0.25);
    background: linear-gradient(160deg, #eef1ef, #e2e7e5);
    display: grid;
    place-items: center;
    text-align: center;
    color: var(--muted);
    font-size: 0.7rem;
    padding: 16px;
  }
  .rv-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .rv-grid figure {
    margin: 0;
    padding: 28px;
    border-radius: 22px;
    background: var(--card);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
  }
  blockquote {
    margin: 0;
    line-height: 1.6;
  }
  figcaption {
    color: var(--muted);
    font-weight: 600;
    font-size: 0.9rem;
  }
  .finale {
    padding: clamp(96px, 13vw, 170px) 16px;
    text-align: center;
    background:
      radial-gradient(40% 60% at 35% 100%, rgb(66 125 184 / 0.3), transparent 70%),
      radial-gradient(40% 60% at 65% 100%, rgb(234 91 12 / 0.3), transparent 70%),
      #05090b;
    color: #eef3f5;
  }
  .muted {
    color: #93a6ae;
  }
  .giant {
    display: inline-flex;
    gap: 0.25em;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: clamp(3.2rem, 10vw, 9rem);
    letter-spacing: -0.05em;
    line-height: 1.1;
    padding-bottom: 0.08em;
    text-decoration: none;
  }
  .giant i {
    font-style: normal;
    color: #ff7a2f;
  }
  .sub {
    margin-top: 20px;
  }
  @media (max-width: 860px) {
    .reis-grid {
      grid-template-columns: 90px 1fr;
      gap: 20px;
    }
    .sticky .eyebrow {
      display: none;
    }
    .sticky :global(.thermo),
    .sticky :global(.thermo svg) {
      width: 70px;
      margin-left: 0;
    }
    .sticky :global(.schaal) {
      display: none;
    }
    .d-grid,
    .rv-grid {
      grid-template-columns: 1fr;
    }
    .rv-head {
      grid-template-columns: 100px 1fr;
    }
    .onderhoud {
      border-radius: 22px;
    }
  }
</style>
