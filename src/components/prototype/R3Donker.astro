---
// PROTOTYPE ronde 3 – A "Donker": vaste hero, daaronder thermometer-keuze die de rustige secties aanstuurt.
import { getCollection } from 'astro:content';
import { bedrijf, telLink } from '../../lib/bedrijf';
import R3Hero from './R3Hero.astro';
import Thermometer from './Thermometer.astro';
import TechTekening from './TechTekening.astro';

const reviews = (await getCollection('reviews')).slice(0, 2);
---

<div class="r3a" data-modus="koel">
  <R3Hero thema="donker" />

  <div class="trust">
    <span class="ph">★ Google-score volgt</span>
    <span><b>{bedrijf.jarenErvaring}</b> jaar ervaring</span>
    <span>Specialist <b>{bedrijf.merk}</b></span>
    <span>Gevestigd in <b>{bedrijf.adres.plaats}</b></span>
  </div>

  <section class="keuze">
    <div class="wrap keuze-grid">
      <div class="thermos" aria-hidden="true">
        <Thermometer id="a-buiten" label="Buiten" temp={31} />
        <Thermometer id="a-binnen" label="Binnen" temp={21} />
      </div>
      <div>
        <p class="eyebrow mono">Wat zoek je?</p>
        <div class="seg" role="radiogroup" aria-label="Koelen of verwarmen">
          <button role="radio" aria-checked="true" data-zet="koel">❄ Koelen</button>
          <button role="radio" aria-checked="false" data-zet="warm">☀ Verwarmen</button>
        </div>
        <h2>
          <span data-m="koel">Buiten heet.<br /><em>Binnen koel.</em></span>
          <span data-m="warm">Buiten koud.<br /><em>Binnen warm.</em></span>
        </h2>
        <p class="lead">
          <span data-m="koel">Een stille airco van {bedrijf.merk} koelt je huis in de zomer, en verwarmt zuinig in het voor- en najaar.</span>
          <span data-m="warm">Een warmtepomp verwarmt je huis met veel minder gas. Hybride naast je cv-ketel, of volledig elektrisch.</span>
        </p>
        <a class="btn" href="#"><span data-m="koel">Offerte voor een airco</span><span data-m="warm">Offerte voor een warmtepomp</span></a>
      </div>
    </div>
  </section>

  <section class="zo">
    <div class="wrap zo-grid">
      <div>
        <p class="eyebrow mono">Zo werkt het</p>
        <h2 class="h2s">
          <span data-m="koel">Wat er bij je aan de muur komt.</span>
          <span data-m="warm">Wat er bij je huis komt te staan.</span>
        </h2>
        <ul class="punten" data-m="koel">
          <li><b>01</b> Koelen én zuinig verwarmen</li>
          <li><b>02</b> Stil, met de beste plek voor binnen- en buitenunit</li>
          <li><b>03</b> Leidingen strak weggewerkt</li>
        </ul>
        <ul class="punten" data-m="warm">
          <li><b>01</b> Eerlijk advies over isolatie en afgifte</li>
          <li><b>02</b> Hybride of all-electric</li>
          <li><b>03</b> Zorgvuldig ingeregeld</li>
        </ul>
      </div>
      <div data-m="koel">
        <TechTekening soort="binnen" kleur="#7fb4ea" labels={[{ letter: 'A', tekst: 'Fluisterstil', x: 2, y: 6 }, { letter: 'B', tekst: 'Instelbare luchtstroom', x: 50, y: 84 }]} />
      </div>
      <div data-m="warm">
        <TechTekening soort="buiten" kleur="#ff7a2f" labels={[{ letter: 'A', tekst: 'Warmte uit de buitenlucht', x: 0, y: 4 }, { letter: 'B', tekst: 'Strak en waterpas', x: 48, y: 88 }]} />
      </div>
    </div>
  </section>

  <section class="sjoerd">
    <div class="wrap sj-grid">
      <div class="portret" aria-label="Foto van Sjoerd volgt"><span class="mono">Foto Sjoerd volgt</span></div>
      <div>
        <p class="eyebrow mono">Je krijgt Sjoerd</p>
        <h2 class="h2s">Geen callcenter, geen wisselende monteurs.</h2>
        <p class="lead">
          Van het eerste gesprek tot het onderhoud jaren later: je hebt één aanspreekpunt. Ik kom zelf langs, ik
          installeer zelf, en ik neem zelf de telefoon op.
        </p>
        <a class="ghost" href={telLink}>Bel Sjoerd · {bedrijf.telefoon.weergave}</a>
      </div>
    </div>
  </section>

  <section class="reviews">
    <div class="wrap rev-grid">
      {
        reviews.map((r) => (
          <figure>
            <blockquote>“{r.data.tekst}”</blockquote>
            <figcaption>{r.data.naam} · Google</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="finale">
    <p class="muted">Benieuwd wat past bij jouw huis?</p>
    <a class="giant" href={telLink}>Bel Sjoerd <i>→</i></a>
    <p class="muted sub">{bedrijf.telefoon.weergave} · {bedrijf.email}</p>
  </section>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.r3a')!;
  const zet = (m: string) => {
    root.dataset.modus = m;
    root.querySelectorAll('[data-zet]').forEach((b) => b.setAttribute('aria-checked', String((b as HTMLElement).dataset.zet === m)));
    const buiten = root.querySelector<HTMLElement>('#a-buiten')!;
    const t = m === 'koel' ? 31 : -4;
    buiten.style.setProperty('--temp', String(t));
    buiten.querySelector('[data-waarde]')!.textContent = `${t}°`;
  };
  root.querySelectorAll<HTMLButtonElement>('[data-zet]').forEach((b) => b.addEventListener('click', () => zet(b.dataset.zet!)));
</script>

<style>
  .r3a {
    --bg: #05090b;
    --ink: #eef3f5;
    --muted: #93a6ae;
    --line: rgb(255 255 255 / 0.1);
    --accent: #8fc1f0;
    background: var(--bg);
    color: var(--ink);
  }
  .r3a[data-modus='warm'] {
    --accent: #ff7a2f;
  }
  .wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 40px);
  }
  .mono {
    font-family: 'IBM Plex Mono', monospace;
  }
  [data-m] {
    display: none;
  }
  .r3a[data-modus='koel'] [data-m='koel'],
  .r3a[data-modus='warm'] [data-m='warm'] {
    display: revert;
  }
  .trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 40px;
    padding: 20px 16px;
    border-block: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.95rem;
  }
  .trust b {
    color: var(--ink);
  }
  .ph {
    color: #ffb27d;
    border: 1px dashed rgb(255 122 47 / 0.6);
    padding: 2px 10px;
    border-radius: 999px;
  }
  .keuze,
  .zo,
  .sjoerd,
  .reviews {
    padding: clamp(80px, 10vw, 130px) 0;
  }
  .keuze-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(40px, 8vw, 120px);
    align-items: center;
  }
  .thermos {
    display: flex;
    gap: 40px;
    padding-right: 30px;
  }
  .eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    transition: color 0.6s;
  }
  .seg {
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    padding: 5px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgb(255 255 255 / 0.03);
    margin: 4px 0 32px;
  }
  .seg button {
    border: 0;
    background: none;
    color: var(--muted);
    font: inherit;
    font-weight: 700;
    padding: 12px 22px;
    border-radius: 999px;
    cursor: pointer;
  }
  .seg [aria-checked='true'] {
    background: var(--accent);
    color: #061419;
  }
  .r3a h2 {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: clamp(2.6rem, 5.4vw, 4.8rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    margin: 0 0 22px;
  }
  .r3a h2 em {
    font-style: normal;
    color: var(--accent);
    transition: color 0.6s;
  }
  .r3a .h2s {
    font-size: clamp(2rem, 3.8vw, 3rem);
    line-height: 1.05;
  }
  .lead {
    color: var(--muted);
    font-size: 1.12rem;
    max-width: 46ch;
    margin: 0 0 28px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 24px;
    border-radius: 999px;
    background: #c94a06;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }
  .ghost {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 22px;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-weight: 600;
    text-decoration: none;
  }
  .zo {
    border-top: 1px solid var(--line);
  }
  .zo-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 56px;
    align-items: center;
  }
  .punten {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    border-top: 1px solid var(--line);
  }
  .punten li {
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    font-weight: 500;
  }
  .punten b {
    font-family: 'IBM Plex Mono', monospace;
    color: var(--accent);
    margin-right: 14px;
    font-size: 0.85rem;
  }
  .sjoerd {
    border-top: 1px solid var(--line);
    background: radial-gradient(40% 60% at 15% 50%, rgb(66 125 184 / 0.12), transparent 70%);
  }
  .sj-grid {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 64px;
    align-items: center;
  }
  .portret {
    aspect-ratio: 4 / 5;
    border-radius: 24px;
    border: 1px dashed rgb(255 255 255 / 0.25);
    background:
      radial-gradient(60% 50% at 50% 35%, rgb(255 255 255 / 0.06), transparent 70%),
      linear-gradient(160deg, #0f1d23, #070d10);
    display: grid;
    place-items: end start;
    padding: 18px;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .rev-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
  }
  .reviews {
    border-top: 1px solid var(--line);
  }
  .reviews figure {
    margin: 0;
    padding-top: 24px;
    border-top: 2px solid var(--accent);
  }
  blockquote {
    margin: 0 0 16px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    line-height: 1.4;
  }
  figcaption {
    color: var(--muted);
  }
  .finale {
    padding: clamp(96px, 13vw, 170px) 16px;
    text-align: center;
    border-top: 1px solid var(--line);
    background:
      radial-gradient(40% 60% at 35% 100%, rgb(66 125 184 / 0.25), transparent 70%),
      radial-gradient(40% 60% at 65% 100%, rgb(234 91 12 / 0.25), transparent 70%);
  }
  .muted {
    color: var(--muted);
  }
  .giant {
    display: inline-flex;
    gap: 0.25em;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: clamp(3.2rem, 10vw, 9rem);
    letter-spacing: -0.05em;
    line-height: 1.1;
    padding-bottom: 0.08em;
    text-decoration: none;
  }
  .giant i {
    font-style: normal;
    color: var(--accent);
  }
  .sub {
    margin-top: 20px;
  }
  @media (max-width: 860px) {
    .keuze-grid,
    .zo-grid,
    .sj-grid,
    .rev-grid {
      grid-template-columns: 1fr;
    }
    .thermos {
      justify-content: center;
      transform: scale(0.85);
    }
    .portret {
      max-width: 320px;
    }
  }
</style>
