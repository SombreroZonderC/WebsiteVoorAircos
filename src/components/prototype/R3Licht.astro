---
// PROTOTYPE ronde 3 – B "Licht": vaste hero in licht, kies jouw ruimte met prijsindicatie, thermometers zomer/winter.
import { getCollection } from 'astro:content';
import { bedrijf, telLink } from '../../lib/bedrijf';
import R3Hero from './R3Hero.astro';
import Thermometer from './Thermometer.astro';

const review = (await getCollection('reviews')).find((r) => r.id === 'google-reviewer')!;
const ruimtes = [
  { naam: 'Woonkamer', tekst: 'Krachtig koelen en snel bijverwarmen, mooi weggewerkt.', soort: 'Airco', icoon: 'M4 18v-5a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v5M2 18h20M6 18v2M18 18v2M7 10V7a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v3' },
  { naam: 'Slaapkamer', tekst: 'Fluisterstil, zodat je ook op hete nachten goed slaapt.', soort: 'Airco', icoon: 'M3 18V8M21 18v-5a3 3 0 0 0-3-3H8v8M3 14h18M6 11.5a1.5 1.5 0 1 0 0-.01' },
  { naam: 'Zolder', tekst: 'De warmste plek van het huis, eindelijk bruikbaar in de zomer.', soort: 'Airco', icoon: 'M3 20 12 5l9 15M7 20v-5h10v5M10 11h4' },
  { naam: 'Het hele huis', tekst: 'Verwarmen met minder gas: hybride of all-electric warmtepomp.', soort: 'Warmtepomp', icoon: 'M3 11 12 4l9 7M5 10v10h14V10M10 20v-5h4v5' },
];
---

<div class="r3b">
  <R3Hero thema="licht" />

  <div class="trust">
    <span class="ph">★ Google-score volgt</span>
    <span><b>{bedrijf.jarenErvaring}</b> jaar ervaring</span>
    <span>Specialist <b>{bedrijf.merk}</b></span>
    <span>Gevestigd in <b>{bedrijf.adres.plaats}</b></span>
  </div>

  <section class="ruimtes">
    <div class="wrap">
      <p class="eyebrow mono">Kies jouw ruimte</p>
      <h2>Waar wil je het comfortabel hebben?</h2>
      <div class="r-grid">
        {
          ruimtes.map((r) => (
            <a class:list={['ruimte', { warm: r.soort === 'Warmtepomp' }]} href="#">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={r.icoon} />
              </svg>
              <span class="soort mono">{r.soort}</span>
              <h3>{r.naam}</h3>
              <p>{r.tekst}</p>
              <span class="prijs">
                Indicatie vanaf <span class="ph">€ … (volgt)</span>
              </span>
              <span class="pijl">→</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="seizoenen">
    <div class="wrap s-grid">
      <div class="s-copy">
        <p class="eyebrow mono">Het hele jaar 21°</p>
        <h2>Eén systeem, twee seizoenen.</h2>
        <p class="lead">
          Een airco koelt in de zomer en verwarmt in het tussenseizoen. Een warmtepomp verwarmt je huis in de winter.
          Ik adviseer eerlijk wat bij jouw huis past.
        </p>
      </div>
      <div class="pair zomer" aria-hidden="true">
        <span class="tag mono">Zomer</span>
        <div class="tt">
          <Thermometer id="b-zb" label="Buiten" temp={31} thema="licht" />
          <Thermometer id="b-zi" label="Binnen" temp={21} thema="licht" />
        </div>
      </div>
      <div class="pair winter" aria-hidden="true">
        <span class="tag mono">Winter</span>
        <div class="tt">
          <Thermometer id="b-wb" label="Buiten" temp={-4} thema="licht" />
          <Thermometer id="b-wi" label="Binnen" temp={21} thema="licht" />
        </div>
      </div>
    </div>
  </section>

  <section class="stappen">
    <div class="wrap">
      <p class="eyebrow mono">Zo werk ik</p>
      <ol>
        <li><b>01</b><h3>Bellen of mailen</h3><p>Je vertelt kort wat je zoekt.</p></li>
        <li><b>02</b><h3>Advies aan huis</h3><p>Ik kom langs en kijk naar de situatie.</p></li>
        <li><b>03</b><h3>Heldere offerte</h3><p>Vrijblijvend, zonder kleine lettertjes.</p></li>
        <li><b>04</b><h3>Nette installatie</h3><p>Getest, opgeruimd en uitgelegd.</p></li>
      </ol>
    </div>
  </section>

  <section class="sjoerd">
    <div class="wrap sj">
      <div class="portret"><span class="mono">Foto Sjoerd volgt</span></div>
      <div>
        <blockquote>“{review.data.tekst}”</blockquote>
        <p class="muted">Google-review</p>
        <hr />
        <p class="eyebrow mono">Je krijgt Sjoerd</p>
        <p class="lead">Eén aanspreekpunt, van het eerste gesprek tot het onderhoud jaren later.</p>
      </div>
    </div>
  </section>

  <section class="finale">
    <p class="muted">Benieuwd wat past bij jouw huis?</p>
    <a class="giant" href={telLink}>Bel Sjoerd <i>→</i></a>
    <p class="muted sub">{bedrijf.telefoon.weergave} · {bedrijf.email}</p>
  </section>
</div>

<style>
  .r3b {
    --bg: #f5f6f4;
    --card: #ffffff;
    --ink: #0c1d23;
    --muted: #52666d;
    --line: rgb(12 29 35 / 0.1);
    --blue: #2a64a3;
    --orange: #b8460a;
    background: var(--bg);
    color: var(--ink);
  }
  .wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 40px);
  }
  .mono {
    font-family: 'IBM Plex Mono', monospace;
  }
  .trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 40px;
    padding: 20px 16px;
    border-block: 1px solid var(--line);
    background: var(--card);
    color: var(--muted);
    font-size: 0.95rem;
  }
  .trust b {
    color: var(--ink);
  }
  .ph {
    color: var(--orange);
    border: 1px dashed rgb(184 70 10 / 0.6);
    padding: 1px 9px;
    border-radius: 999px;
    font-size: 0.9em;
  }
  .ruimtes,
  .seizoenen,
  .stappen,
  .sjoerd {
    padding: clamp(80px, 10vw, 130px) 0;
  }
  .eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue);
  }
  .r3b h2 {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: clamp(2.2rem, 4.4vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    margin: 0 0 40px;
    max-width: 20ch;
  }
  .r-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  .ruimte {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 26px;
    border-radius: 22px;
    background: var(--card);
    border: 1px solid var(--line);
    text-decoration: none;
    transition:
      transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.35s;
  }
  .ruimte:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 48px -28px rgb(12 29 35 / 0.35);
  }
  .ruimte svg {
    width: 40px;
    height: 40px;
    fill: none;
    stroke: var(--blue);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    margin-bottom: 18px;
  }
  .ruimte.warm svg {
    stroke: var(--orange);
  }
  .soort {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--blue);
  }
  .ruimte.warm .soort {
    color: var(--orange);
  }
  .ruimte h3 {
    font-family: var(--font-display);
    font-size: 1.45rem;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .ruimte p {
    margin: 0;
    color: var(--muted);
    flex: 1;
  }
  .prijs {
    font-size: 0.88rem;
    color: var(--muted);
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .pijl {
    position: absolute;
    top: 24px;
    right: 26px;
    font-size: 1.3rem;
    transition: transform 0.3s;
  }
  .ruimte:hover .pijl {
    transform: translateX(4px);
  }
  .seizoenen {
    background: var(--card);
    border-block: 1px solid var(--line);
  }
  .s-grid {
    display: grid;
    grid-template-columns: 1.1fr auto auto;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .lead {
    color: var(--muted);
    font-size: 1.12rem;
    max-width: 46ch;
  }
  .pair {
    position: relative;
    padding: 28px 28px 20px;
    border-radius: 26px;
    border: 1px solid var(--line);
  }
  .zomer {
    background: linear-gradient(180deg, rgb(255 154 90 / 0.08), transparent);
  }
  .winter {
    background: linear-gradient(180deg, rgb(63 127 194 / 0.08), transparent);
  }
  .tag {
    position: absolute;
    top: -12px;
    left: 24px;
    background: var(--card);
    padding: 2px 10px;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .tt {
    display: flex;
    gap: 22px;
    padding-right: 26px;
  }
  .tt :global(.thermo) {
    width: 90px;
  }
  .tt :global(.thermo svg) {
    width: 90px;
  }
  .stappen ol {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
  }
  .stappen li {
    padding: 28px 24px 0 0;
    position: relative;
  }
  .stappen li::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 40px;
    height: 2px;
    background: var(--orange);
  }
  .stappen b {
    font-family: 'IBM Plex Mono', monospace;
    color: var(--orange);
    font-size: 0.85rem;
  }
  .stappen h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin: 14px 0 6px;
  }
  .stappen p {
    color: var(--muted);
    margin: 0;
  }
  .sjoerd {
    background: var(--card);
    border-top: 1px solid var(--line);
  }
  .sj {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 64px;
    align-items: center;
  }
  .portret {
    aspect-ratio: 4 / 5;
    border-radius: 24px;
    border: 1px dashed rgb(12 29 35 / 0.25);
    background: linear-gradient(160deg, #eef1ef, #e2e7e5);
    display: grid;
    place-items: end start;
    padding: 18px;
    color: var(--muted);
    font-size: 0.8rem;
  }
  blockquote {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    line-height: 1.35;
    letter-spacing: -0.015em;
  }
  hr {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 32px 0;
  }
  .muted {
    color: var(--muted);
  }
  .finale {
    padding: clamp(96px, 13vw, 170px) 16px;
    text-align: center;
    background:
      radial-gradient(40% 60% at 35% 100%, rgb(66 125 184 / 0.14), transparent 70%),
      radial-gradient(40% 60% at 65% 100%, rgb(234 91 12 / 0.14), transparent 70%);
  }
  .giant {
    display: inline-flex;
    gap: 0.25em;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: clamp(3.2rem, 10vw, 9rem);
    letter-spacing: -0.05em;
    line-height: 1.1;
    padding-bottom: 0.08em;
    text-decoration: none;
    color: var(--ink);
  }
  .giant i {
    font-style: normal;
    color: var(--orange);
  }
  .sub {
    margin-top: 20px;
  }
  @media (max-width: 1000px) {
    .r-grid {
      grid-template-columns: 1fr 1fr;
    }
    .s-grid {
      grid-template-columns: 1fr 1fr;
    }
    .s-copy {
      grid-column: 1 / -1;
    }
    .stappen ol {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
  }
  @media (max-width: 640px) {
    .r-grid,
    .s-grid,
    .sj,
    .stappen ol {
      grid-template-columns: 1fr;
    }
    .pair {
      justify-self: center;
    }
    .portret {
      max-width: 300px;
    }
  }
</style>
