---
// PROTOTYPE – wegwerp. Richting C: "Groot & vet" – oversized typografie en een bento-grid.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { bedrijf, telLink } from '../../lib/bedrijf';
import projectFoto from '../../assets/project-dakopstelling.jpg';

const reviews = await getCollection('reviews');
const review = reviews.find((r) => r.id === 'harriet-eenkhoorn') ?? reviews[0];
const band = ['Airconditioning', 'Warmtepompen', 'Onderhoud', bedrijf.merk, 'Advies aan huis', 'Heeten e.o.'];
---

<div class="vc">
  <header class="vc-top">
    <img src="/images/logo-op-donker.svg" alt="The CoolFactory" />
    <nav><a href="#">Airco</a><a href="#">Warmtepompen</a><a href="#">Onderhoud</a><a href="#">Over Sjoerd</a></nav>
    <a class="vc-pill" href="#">Offerte</a>
  </header>

  <section class="vc-hero">
    <a class="half koel" href="#">
      <span class="word">Koel</span>
      <span class="sub">in de zomer — airconditioning</span>
    </a>
    <a class="half warm" href="#">
      <span class="word">Warm</span>
      <span class="sub">in de winter — warmtepompen</span>
    </a>
    <p class="vc-intro">
      Airco &amp; warmtepompen in Heeten.<br />Door Sjoerd. Al {bedrijf.jarenErvaring} jaar.
    </p>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="track">
      {[...band, ...band, ...band].map((t) => <span>{t} <i>✦</i></span>)}
    </div>
  </div>

  <section class="bento">
    <div class="tile big-num">
      <span class="num">{bedrijf.jarenErvaring}</span>
      <span class="cap">jaar in het vak. Advies dat onderbouwd is, van iemand die het vak kent.</span>
    </div>
    <figure class="tile photo">
      <Image src={projectFoto} alt="Buitenunit met omkasting op een plat dak" widths={[600, 1000]} sizes="50vw" />
      <figcaption>Recent werk — netjes weggewerkt op het dak</figcaption>
    </figure>
    <a class="tile svc blue" href="#">
      <span class="k">01</span>
      <h3>Airco</h3>
      <p>Koelen én zuinig verwarmen. Stil, strak gemonteerd.</p>
      <span class="arrow">→</span>
    </a>
    <a class="tile svc orange" href="#">
      <span class="k">02</span>
      <h3>Warmte&shy;pomp</h3>
      <p>Hybride of all-electric. Minder gas, meer comfort.</p>
      <span class="arrow">→</span>
    </a>
    <a class="tile svc ink" href="#">
      <span class="k">03</span>
      <h3>Onderhoud</h3>
      <p>Langer zorgeloos, zuiniger, stiller.</p>
      <span class="arrow">→</span>
    </a>
    <div class="tile brand">
      <span class="num small">1</span>
      <span class="cap">merk. Uitsluitend {bedrijf.merk}. Ik ken elk systeem door en door.</span>
    </div>
    <blockquote class="tile quote">
      <p>“{review.data.tekst}”</p>
      <cite>— {review.data.naam}, Google</cite>
    </blockquote>
  </section>

  <section class="vc-cta">
    <p class="pre">Benieuwd wat past bij jouw huis?</p>
    <a class="giant" href={telLink}>Bel Sjoerd<span>→</span></a>
    <p class="tel">{bedrijf.telefoon.weergave} · {bedrijf.email}</p>
  </section>
</div>

<style>
  .vc {
    --paper: #f3f0ea;
    --ink: #0b0b0b;
    --blue: #3f7fc2;
    --orange: #e8580b;
    background: var(--paper);
    color: var(--ink);
    min-height: 100vh;
  }
  .vc-top {
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 14px clamp(16px, 3vw, 32px);
    background: var(--ink);
    color: #fff;
  }
  .vc-top img {
    height: 44px;
    width: auto;
  }
  .vc-top nav {
    display: flex;
    gap: 28px;
    margin-left: auto;
    font-weight: 600;
  }
  .vc-top nav a {
    text-decoration: none;
  }
  .vc-pill {
    background: var(--orange);
    color: #fff;
    font-weight: 800;
    text-decoration: none;
    padding: 12px 22px;
    border-radius: 999px;
  }

  .vc-hero {
    position: relative;
    display: flex;
    height: min(78vh, 760px);
    min-height: 480px;
  }
  .half {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(16px, 3vw, 32px);
    color: #fff;
    text-decoration: none;
    overflow: hidden;
    transition: flex 0.7s cubic-bezier(0.7, 0, 0.2, 1);
  }
  .half:hover {
    flex: 1.6;
  }
  .koel {
    background: var(--blue);
  }
  .warm {
    background: var(--orange);
  }
  .word {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(4rem, 10.5vw, 11rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }
  .sub {
    font-weight: 700;
    font-size: clamp(0.95rem, 1.4vw, 1.15rem);
    margin-top: 18px;
    opacity: 0.9;
  }
  .vc-intro {
    position: absolute;
    top: clamp(24px, 4vw, 48px);
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    padding: 18px 26px;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-display);
    font-stretch: 110%;
    font-weight: 800;
    font-size: clamp(1rem, 1.8vw, 1.4rem);
    line-height: 1.2;
    text-align: center;
    border-radius: 18px;
    box-shadow: 0 20px 40px -20px rgb(0 0 0 / 0.4);
    white-space: nowrap;
  }

  .marquee {
    overflow: hidden;
    background: var(--ink);
    color: #fff;
    padding: 20px 0;
  }
  .track {
    display: flex;
    width: max-content;
    gap: 40px;
    animation: vc-scroll 30s linear infinite;
  }
  .track span {
    font-family: var(--font-display);
    font-stretch: 120%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.4rem, 3vw, 2.4rem);
    white-space: nowrap;
  }
  .track i {
    font-style: normal;
    color: var(--orange);
    margin-left: 40px;
  }
  @keyframes vc-scroll {
    to {
      transform: translateX(-33.333%);
    }
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: minmax(220px, auto);
    gap: 12px;
    padding: 12px;
  }
  .tile {
    position: relative;
    margin: 0;
    border-radius: 28px;
    padding: clamp(20px, 2.4vw, 32px);
    background: #fff;
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  a.tile:hover {
    transform: translateY(-6px) rotate(-0.4deg);
  }
  .big-num {
    grid-column: span 2;
    grid-row: span 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .num {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 900;
    font-size: clamp(8rem, 22vw, 20rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: var(--orange);
  }
  .num.small {
    font-size: clamp(5rem, 10vw, 9rem);
    color: var(--blue);
  }
  .cap {
    font-family: var(--font-display);
    font-stretch: 105%;
    font-weight: 700;
    font-size: clamp(1.1rem, 1.8vw, 1.5rem);
    line-height: 1.25;
    max-width: 24ch;
  }
  .photo {
    grid-column: span 2;
    grid-row: span 2;
    padding: 0;
    min-height: 420px;
  }
  .photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo figcaption {
    position: absolute;
    left: 16px;
    bottom: 16px;
    background: var(--paper);
    padding: 8px 14px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.85rem;
  }
  .svc {
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: #fff;
    min-height: 300px;
  }
  .svc.blue {
    background: var(--blue);
  }
  .svc.orange {
    background: var(--orange);
  }
  .svc.ink {
    background: var(--ink);
  }
  .k {
    font-weight: 800;
    opacity: 0.7;
  }
  .svc h3 {
    font-family: var(--font-display);
    font-stretch: 110%;
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(1.8rem, 2.6vw, 2.6rem);
    line-height: 0.9;
    margin: auto 0 0;
    hyphens: manual;
  }
  .svc p {
    margin: 0;
    font-weight: 500;
  }
  .arrow {
    position: absolute;
    top: 22px;
    right: 26px;
    font-size: 2rem;
    transition: transform 0.3s;
  }
  a.tile:hover .arrow {
    transform: translate(4px, -4px) rotate(-45deg);
  }
  .quote {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: #e3ddd2;
  }
  .quote p {
    font-family: var(--font-display);
    font-stretch: 100%;
    font-weight: 700;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    line-height: 1.3;
    margin: 0 0 16px;
  }
  .quote cite {
    font-style: normal;
    font-weight: 600;
  }
  .brand {
    grid-column: span 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .vc-cta {
    padding: clamp(80px, 12vw, 160px) clamp(16px, 3vw, 32px);
    text-align: center;
  }
  .pre {
    font-weight: 700;
    font-size: 1.2rem;
    margin: 0 0 12px;
  }
  .giant {
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(3.2rem, 12vw, 11rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-decoration: none;
    color: var(--ink);
    transition: color 0.3s;
  }
  .giant span {
    color: var(--orange);
    transition: transform 0.3s;
  }
  .giant:hover {
    color: var(--orange);
  }
  .giant:hover span {
    transform: translateX(16px);
  }
  .tel {
    margin-top: 20px;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .vc-top nav {
      display: none;
    }
    .vc-pill {
      margin-left: auto;
    }
    .vc-hero {
      flex-direction: column;
      height: auto;
    }
    .half {
      min-height: 280px;
    }
    .vc-intro {
      position: static;
      transform: none;
      white-space: normal;
      border-radius: 0;
      box-shadow: none;
      order: -1;
    }
    .bento {
      grid-template-columns: 1fr 1fr;
    }
    .big-num,
    .photo,
    .quote {
      grid-column: span 2;
    }
    .quote {
      grid-column: span 2 !important;
    }
    .photo {
      min-height: 280px;
    }
    .svc.ink,
    .brand {
      grid-column: span 1;
    }
  }
  @media (max-width: 560px) {
    .bento {
      grid-template-columns: 1fr;
    }
    .bento > * {
      grid-column: span 1 !important;
    }
  }
</style>
