---
// Storingswijzer: kies een klacht, zie wat je zelf kunt checken, wat normaal is en wanneer je belt.
// Teksten: src/content/instellingen/onderhoud.json (wijzer). Zonder JS staan alle klachten onder elkaar.
import Icon from './Icon.astro';
import { onderhoud } from '../lib/inhoud';
import { bedrijf, telLink } from '../lib/bedrijf';

const w = onderhoud.wijzer;
const eerste = w.klachten[0].id;
---

<div class="wijzer" data-wijzer data-geen-mobiele-cta>
  <div class="kop">
    <p class="eyebrow cold">{w.eyebrow}</p>
    <h2 id="wijzer-titel">{w.titel}</h2>
    <p class="intro">{w.intro}</p>
  </div>

  <div class="raster">
    <div class="knoppen" role="radiogroup" aria-labelledby="wijzer-titel">
      {
        w.klachten.map((k) => (
          <button
            type="button"
            role="radio"
            aria-checked={k.id === eerste ? 'true' : 'false'}
            tabindex={k.id === eerste ? 0 : -1}
            aria-controls={`klacht-${k.id}`}
            data-klacht={k.id}
          >
            <Icon name={k.icoon} size={22} />
            <span>{k.label}</span>
          </button>
        ))
      }
    </div>

    <div class="panelen" aria-live="polite">
      {
        w.klachten.map((k) => (
          <article class="antwoord" id={`klacht-${k.id}`} data-paneel={k.id} data-zonder-js-tonen hidden={k.id !== eerste}>
            <h3>{k.label}</h3>
            <p class="label">Eerst zelf checken</p>
            <ol class="zelf">
              {k.zelf.map((z) => (
                <li>{z}</li>
              ))}
            </ol>
            <div class="vak normaal">
              <p class="label">Dit is normaal</p>
              <p>{k.normaal}</p>
            </div>
            <div class="vak bellen">
              <p class="label">Bel als</p>
              <p>{k.bellen}</p>
            </div>
            <div class="acties">
              <a class="btn ghost" href={telLink}>
                <Icon name="phone" /> {bedrijf.telefoon.weergave}
              </a>
              <a class="btn ghost" href={`/contact?onderwerp=onderhoud&klacht=${k.id}`}>
                Stuur deze klacht door <Icon name="arrow" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
  <p class="veilig"><Icon name="shield" size={18} /> {w.veilig}</p>
</div>

<script>
  import { radiogroep } from '../scripts/radiogroep';

  document.querySelectorAll<HTMLElement>('[data-wijzer]').forEach((root) => {
    const panelen = [...root.querySelectorAll<HTMLElement>('[data-paneel]')];
    radiogroep([...root.querySelectorAll<HTMLButtonElement>('[data-klacht]')], {
      bijKeuze: (knop) => panelen.forEach((p) => (p.hidden = p.dataset.paneel !== knop.dataset.klacht)),
      // Op smalle schermen staat het antwoord onder de knoppen: even meescrollen.
      bijKlik: () => {
        if (matchMedia('(max-width: 860px)').matches) {
          root.querySelector('.panelen')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      },
    });
  });
</script>

<style>
  .kop {
    max-width: 720px;
    margin-bottom: clamp(28px, 4vw, 44px);
  }
  h2 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    letter-spacing: -0.04em;
    margin: 0 0 12px;
  }
  .intro {
    color: var(--muted);
    font-size: 1.1rem;
    margin: 0;
  }
  .raster {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(16px, 2.5vw, 28px);
    align-items: start;
  }
  .knoppen {
    display: grid;
    gap: 8px;
  }
  .knoppen button {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    min-height: 56px;
    padding: 12px 18px;
    border: 1px solid var(--line);
    border-left: 4px solid transparent;
    background: var(--paper-2);
    color: var(--ink);
    font: 600 1rem/1.3 var(--font-body);
    text-align: left;
    cursor: pointer;
    transition:
      background 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }
  .knoppen button :global(svg) {
    flex: none;
    color: var(--blue-text);
  }
  .knoppen button:hover {
    border-left-color: var(--line);
  }
  .knoppen button[aria-checked='true'] {
    background: var(--ink);
    color: var(--text-on-dark);
    border-color: var(--ink);
    border-left-color: var(--blue-ice);
  }
  .knoppen button[aria-checked='true'] :global(svg) {
    color: var(--blue-ice);
  }
  .antwoord {
    padding: clamp(24px, 3.5vw, 44px);
    background: var(--ink);
    color: var(--text-on-dark);
  }
  .antwoord h3 {
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    letter-spacing: -0.02em;
    margin: 0 0 24px;
  }
  .label {
    margin: 0 0 10px;
    font: 500 0.875rem var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue-ice);
  }
  .zelf {
    list-style: none;
    counter-reset: stap;
    margin: 0 0 28px;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .zelf li {
    counter-increment: stap;
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
  }
  .zelf li::before {
    content: counter(stap, decimal-leading-zero);
    font: 600 1rem var(--font-mono);
    color: var(--blue-ice);
  }
  .vak {
    padding: 16px 20px;
    margin-bottom: 12px;
    border-left: 4px solid var(--blue-ice);
    background: rgb(255 255 255 / 0.05);
  }
  .vak p:last-child {
    margin: 0;
  }
  .bellen {
    border-left-color: var(--orange-hot);
  }
  .bellen .label {
    color: var(--orange-hot);
  }
  .acties {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
  .veilig {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .veilig :global(svg) {
    flex: none;
    color: var(--orange-text);
  }
  /* Zonder JavaScript: alle klachten onder elkaar */
  :global(.no-js) .raster {
    grid-template-columns: minmax(0, 1fr);
  }
  :global(.no-js) .antwoord + .antwoord {
    margin-top: 16px;
  }
  @media (max-width: 860px) {
    .raster {
      grid-template-columns: minmax(0, 1fr);
    }
    .knoppen {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .knoppen button:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
    .knoppen button {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      font-size: 0.95rem;
    }
    .panelen {
      scroll-margin-top: calc(var(--header-h) + 12px);
    }
  }
</style>
