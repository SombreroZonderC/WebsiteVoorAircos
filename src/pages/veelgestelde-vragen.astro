---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FaqLijst from '../components/FaqLijst.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { faqSchema } from '../lib/schema';

const alle = (await getCollection('faq')).sort((a, b) => a.data.volgorde - b.data.volgorde);
const groepen = [
  { id: 'airco', titel: 'Airconditioning', icoon: 'snow', accent: 'koud' },
  { id: 'warmtepomp', titel: 'Warmtepompen', icoon: 'flame', accent: 'warm' },
  { id: 'onderhoud', titel: 'Onderhoud', icoon: 'wrench', accent: 'koud' },
  { id: 'algemeen', titel: 'Algemeen', icoon: 'chat', accent: 'warm' },
] as const;
const metItems = groepen.map((g) => ({ ...g, items: alle.filter((f) => f.data.categorie === g.id) }));
---

<Base
  title="Veelgestelde vragen over airco en warmtepompen"
  description="Antwoorden op veelgestelde vragen over airconditioning, warmtepompen en onderhoud. Van hybride vs. all-electric tot verwarmen met een airco."
  schema={faqSchema(alle)}
>
  <div class="paar">
    <div class="vlak donker plak" data-diepte-vlak data-geen-mobiele-cta>
      <div class="vlak-inhoud">
        <section class="hero">
          <div class="glow" aria-hidden="true"></div>
          <div class="inhoud">
            <p class="eyebrow">Veelgestelde vragen</p>
            <h1 class="woord">Vragen?</h1>
            <p class="intro">Gewoon stellen. Of zoek hieronder in de antwoorden over airco’s, warmtepompen en onderhoud.</p>
            <label class="zoek">
              <span class="sr-only">Zoek in de vragen</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
              <input type="search" placeholder="Bijvoorbeeld: geluid, subsidie, onderhoud…" data-zoekveld />
            </label>
          </div>
        </section>
      </div>
    </div>

    <section class="vlak licht paneel sectie">
      <div class="wrap">
        <nav class="tegels" aria-label="Onderwerpen">
          {
            metItems.map((g) => (
              <a class:list={['tegel', g.accent]} href={`#${g.id}`}>
                <Icon name={g.icoon} size={26} />
                <span>
                  <b>{g.titel}</b>
                  <small>{g.items.length} vragen</small>
                </span>
              </a>
            ))
          }
        </nav>

        <p class="geen" data-geen hidden>Geen vragen gevonden. Bel of mail gerust, dan help ik je direct.</p>

        <div class="groepen">
          {
            metItems.map((g) => (
              <div class="groep" id={g.id} data-groep>
                <h2>{g.titel}</h2>
                <FaqLijst items={g.items} />
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  <CtaBand titel="Staat je vraag er niet tussen?" />
</Base>

<script>
  const veld = document.querySelector<HTMLInputElement>('[data-zoekveld]');
  if (veld) {
    const items = [...document.querySelectorAll<HTMLDetailsElement>('[data-zoek]')];
    const groepen = [...document.querySelectorAll<HTMLElement>('[data-groep]')];
    const geen = document.querySelector<HTMLElement>('[data-geen]')!;
    veld.addEventListener('input', () => {
      const q = veld.value.trim().toLowerCase();
      items.forEach((d) => {
        const past = !q || d.dataset.zoek!.includes(q);
        d.hidden = !past;
        d.open = Boolean(q) && past;
      });
      groepen.forEach((g) => (g.hidden = !g.querySelector('[data-zoek]:not([hidden])')));
      geen.hidden = groepen.some((g) => !g.hidden);
    });
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: calc(var(--header-h) + clamp(28px, 5vw, 64px)) clamp(16px, 4vw, 56px) clamp(48px, 6vw, 80px);
  }
  .hero .glow {
    background:
      radial-gradient(45% 55% at 20% 30%, rgb(66 125 184 / 0.35), transparent 70%),
      radial-gradient(40% 50% at 70% 90%, rgb(234 91 12 / 0.3), transparent 70%);
  }
  .inhoud {
    position: relative;
    max-width: 860px;
  }
  .woord {
    font-size: clamp(4rem, 13vw, 12rem);
    font-stretch: 115%;
    line-height: 0.86;
    letter-spacing: -0.06em;
    margin: 0 0 18px;
  }
  .intro {
    color: var(--muted-on-dark);
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    max-width: 52ch;
    margin: 0 0 28px;
  }
  .zoek {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 620px;
    padding: 6px 8px 6px 20px;
    border-radius: 999px;
    border: 1px solid var(--line-dark);
    background: rgb(255 255 255 / 0.06);
  }
  .zoek:focus-within {
    border-color: var(--orange-hot);
  }
  .zoek svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: var(--muted-on-dark);
    stroke-width: 2;
    stroke-linecap: round;
    flex: none;
  }
  .zoek input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    color: var(--text-on-dark);
    font: inherit;
    font-size: 1.05rem;
    padding: 12px 0;
    outline: none;
  }
  .zoek input::placeholder {
    color: var(--muted-on-dark);
  }
  .sectie {
    padding-block: clamp(64px, 8vw, 110px);
  }
  .tegels {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .tegel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    min-height: 130px;
    padding: 20px;
    border-radius: 20px;
    background: var(--paper-2);
    border: 1px solid var(--line);
    text-decoration: none;
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }
  .tegel:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 40px -26px rgb(12 29 35 / 0.4);
  }
  .tegel :global(svg) {
    color: var(--blue-text);
  }
  .tegel.warm :global(svg) {
    color: var(--orange-text);
  }
  .tegel b {
    display: block;
    font-family: var(--font-display);
    font-size: 1.15rem;
  }
  .tegel small {
    color: var(--muted);
  }
  .geen {
    margin-top: 40px;
    font-weight: 600;
  }
  .groepen {
    max-width: 860px;
  }
  .groep {
    margin-top: clamp(48px, 6vw, 72px);
  }
  .groep h2 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    margin-bottom: 18px;
  }
  @media (max-width: 860px) {
    .tegels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
