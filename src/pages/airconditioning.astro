---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import projectFoto from '../assets/project-dakopstelling.jpg';
import Base from '../layouts/Base.astro';
import ReuzenHero from '../components/ReuzenHero.astro';
import OpstellingKiezer from '../components/OpstellingKiezer.astro';
import ScrollUitleg from '../components/ScrollUitleg.astro';
import AircoOpengewerkt from '../components/AircoOpengewerkt.astro';
import Seizoensband from '../components/Seizoensband.astro';
import Stappen from '../components/Stappen.astro';
import FaqLijst from '../components/FaqLijst.astro';
import LeesOok from '../components/LeesOok.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import RuimteKaarten from '../components/RuimteKaarten.astro';
import { airco } from '../lib/inhoud';
import { bedrijf, home, telLink } from '../lib/bedrijf';
import { laadDienst } from '../lib/dienst';

const { dienst, d, faqs, schema } = await laadDienst('airconditioning');
const { Content } = await render(dienst);
const ruimtes = home.keuze.koel.ruimtes;
---

<Base title={d.seoTitel} description={d.seoOmschrijving} schema={schema}>
  <div class="paar">
    <ReuzenHero woord="Koel." kleur="koud" eyebrow="Airconditioning · Heeten" titel={d.titel} tekst={d.intro} temp={{ buiten: 31, binnen: 21 }}>
      <a class="btn" href="/contact?onderwerp=airconditioning">Offerte voor een airco <Icon name="arrow" /></a>
      <a class="btn ghost" href={telLink}><Icon name="phone" /> {bedrijf.telefoon.weergave}</a>
    </ReuzenHero>
    <section class="vlak licht paneel sectie">
      <div class="wrap"><OpstellingKiezer /></div>
    </section>
  </div>

  <section class="vlak donker">
    <ScrollUitleg eyebrow={airco.opengewerkt.eyebrow} titel={airco.opengewerkt.titel} stappen={airco.opengewerkt.stappen}>
      <AircoOpengewerkt slot="beeld" />
    </ScrollUitleg>
  </section>

  <section class="vlak licht sectie">
    <div class="wrap">
      <p class="eyebrow cold">{airco.seizoen.eyebrow}</p>
      <h2 class="h2">{airco.seizoen.titel}</h2>
      <Seizoensband />

      <div class="ruimte-rij"><RuimteKaarten ruimtes={ruimtes} soort="Airco" accent="koud" metPrijs={false} /></div>

      <figure class="project">
        <Image src={projectFoto} alt="Buitenunit met donkere lamellen-omkasting op een plat dak" widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 55vw" />
        <figcaption>
          <span class="eyebrow cold">Recent werk</span>
          <b>Netjes weggewerkt, ook op het dak.</b>
          <span class="muted">Buitenunit op een plat dak, met een strakke omkasting die past bij de gevel.</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="vlak licht sectie rand">
    <div class="wrap body">
      <div class="prose"><Content /></div>
      <aside class="contact-kaart card">
        <h2 class="h3">Advies op maat?</h2>
        <p class="muted">Bel of stuur een bericht, dan plannen we een afspraak aan huis.</p>
        <a class="btn" href="/contact?onderwerp=airconditioning">Offerte aanvragen</a>
        <a class="tel" href={telLink}><Icon name="phone" size={18} /> {bedrijf.telefoon.weergave}</a>
        <LeesOok artikel="verwarmen-met-een-airco" />
      </aside>
    </div>
    <div class="wrap">
      <h2 class="h2 klein">Zo werk ik</h2>
      <Stappen stappen={home.werkwijze} />
      {
        faqs.length > 0 && (
          <div class="faq">
            <p class="eyebrow">Veelgestelde vragen</p>
            <h2 class="h2 klein">Vragen over airco’s</h2>
            <FaqLijst items={faqs} />
          </div>
        )
      }
    </div>
  </section>

  <CtaBand titel={airco.ctaTitel} />
</Base>

<style>
  .sectie {
    padding-block: clamp(72px, 9vw, 120px);
  }
  .rand {
    border-top: 1px solid var(--line);
  }
  .h2 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    letter-spacing: -0.04em;
    margin-bottom: 24px;
  }
  .h2.klein {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-top: clamp(56px, 7vw, 88px);
  }
  .ruimte-rij {
    margin-top: 40px;
  }
  .project {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    margin: clamp(56px, 7vw, 88px) 0 0;
  }
  .project :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }
  .project figcaption {
    display: grid;
    gap: 8px;
  }
  .project b {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: clamp(40px, 6vw, 88px);
    align-items: start;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .contact-kaart {
    position: sticky;
    top: 100px;
    display: grid;
    gap: 12px;
  }
  .h3 {
    font-size: 1.35rem;
    margin: 0;
  }
  .contact-kaart p {
    margin: 0 0 4px;
  }
  .tel {
    display: inline-flex;
    justify-content: center;
    gap: 8px;
    font-weight: 600;
    text-decoration: none;
  }
  .faq {
    max-width: 860px;
    margin-top: clamp(56px, 7vw, 88px);
  }
  .faq .h2.klein {
    margin-top: 0;
  }
  @media (max-width: 860px) {
    .body,
    .project {
      grid-template-columns: minmax(0, 1fr);
    }
    .contact-kaart {
      position: static;
    }
  }
</style>
