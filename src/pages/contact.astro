---
import Base from '../layouts/Base.astro';
import ContactFormulier from '../components/ContactFormulier.astro';
import Vervolgstappen from '../components/Vervolgstappen.astro';
import { bedrijf, mailLink, telLink } from '../lib/bedrijf';
---

<Base
  kopVast
  title="Contact en offerte aanvragen"
  description={`Vraag een vrijblijvende offerte aan voor een airco of warmtepomp, of neem contact op met ${bedrijf.eigenaar.split(' ')[0]} van ${bedrijf.naam} in ${bedrijf.adres.plaats}. Bel ${bedrijf.telefoon.weergave}.`}
>
  <div class="split">
    <section class="vlak donker links" aria-labelledby="contact-titel" data-geen-mobiele-cta>
      <div class="glow" aria-hidden="true"></div>
      <div class="links-inhoud">
        <p class="eyebrow">Contact</p>
        <h1 id="contact-titel" class="reus">Bel<br />Sjoerd.</h1>
        <a class="nummer" href={telLink}>{bedrijf.telefoon.weergave}</a>
        <p class="gegevens">
          <a href={mailLink}>{bedrijf.email}</a><br />
          {bedrijf.adres.straat}, {bedrijf.adres.postcode} {bedrijf.adres.plaats}
        </p>
        <p class="bereik">
          Bereikbaar: {bedrijf.openingstijden ?? <span class="todo">openingstijden</span>}
        </p>
        <div class="hierna">
          <p class="eyebrow">Wat gebeurt er hierna?</p>
          <Vervolgstappen />
        </div>
      </div>
    </section>

    <section class="vlak licht rechts" aria-labelledby="form-titel" data-geen-mobiele-cta>
      <ContactFormulier />
    </section>
  </div>
</Base>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    min-height: 100vh;
  }
  .links {
    position: relative;
    overflow: hidden;
  }
  .links .glow {
    background:
      radial-gradient(60% 40% at 20% 20%, rgb(66 125 184 / 0.32), transparent 70%);
  }
  .links-inhoud {
    position: sticky;
    top: 0;
    padding: calc(var(--header-h) + clamp(32px, 5vw, 64px)) clamp(20px, 4vw, 56px) 56px;
  }
  .reus {
    font-size: clamp(3.6rem, 8vw, 7.5rem);
    font-stretch: 115%;
    line-height: 0.88;
    letter-spacing: -0.06em;
    margin: 0 0 28px;
  }
  .nummer {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    letter-spacing: -0.02em;
    text-decoration: none;
    margin-bottom: 12px;
  }
  .gegevens,
  .bereik {
    color: var(--muted-on-dark);
    margin: 0 0 12px;
  }
  .gegevens a {
    color: var(--text-on-dark);
  }
  .hierna {
    margin-top: 32px;
    padding: 22px 24px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-dark);
    background: rgb(255 255 255 / 0.04);
  }
  .hierna :global(ol) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .hierna :global(li) {
    display: flex;
    align-items: flex-start;
  }
  .hierna :global(b) {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-right: 10px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.14);
    font-size: 0.8rem;
  }
  .rechts {
    padding: calc(var(--header-h) + clamp(32px, 5vw, 64px)) clamp(20px, 4vw, 64px) clamp(56px, 7vw, 96px);
  }
  @media (max-width: 960px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }
    .links-inhoud {
      position: static;
      padding-bottom: 40px;
    }
    .rechts {
      padding-top: clamp(40px, 8vw, 64px);
    }
  }
</style>
