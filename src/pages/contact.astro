---
import { onderhoud, warmtepomp } from '../lib/inhoud';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { bedrijf, mailLink, telLink } from '../lib/bedrijf';

const tegels = [
  { waarde: 'airconditioning', label: 'Koelen', sub: 'Airco', icoon: 'snow', accent: 'koud' },
  { waarde: 'warmtepompen', label: 'Verwarmen', sub: 'Warmtepomp', icoon: 'flame', accent: 'warm' },
  { waarde: 'onderhoud', label: 'Onderhoud', sub: 'of storing', icoon: 'wrench', accent: 'koud' },
] as const;
---

<Base
  kopVast
  title="Contact en offerte aanvragen"
  description="Vraag een vrijblijvende offerte aan voor een airco of warmtepomp, of neem contact op met Sjoerd van The CoolFactory in Heeten. Bel 06 211 276 12."
>
  <div class="split">
    <section class="vlak donker links" aria-labelledby="contact-titel" data-geen-mobiele-cta>
      <div class="glow" aria-hidden="true"></div>
      <div class="links-inhoud">
        <p class="eyebrow">Contact</p>
        <h1 id="contact-titel" class="reus">Bel<br />Sjoerd.</h1>
        <a class="nummer" href={telLink}>{bedrijf.telefoon.weergave}</a>
        <p class="gegevens">
          <a href={mailLink}>{bedrijf.email}</a><br />
          {bedrijf.adres.straat}, {bedrijf.adres.postcode} {bedrijf.adres.plaats}
        </p>
        <p class="bereik">
          Bereikbaar: {bedrijf.openingstijden ?? <span class="todo">openingstijden</span>}
        </p>
        <div class="hierna">
          <p class="eyebrow">Wat gebeurt er hierna?</p>
          <ol>
            <li><b>1</b> Ik bel of mail je terug.</li>
            <li><b>2</b> We plannen een afspraak voor advies aan huis.</li>
            <li><b>3</b> Je krijgt een heldere, vrijblijvende offerte.</li>
          </ol>
        </div>
      </div>
    </section>

    <section class="vlak licht rechts" aria-labelledby="form-titel" data-geen-mobiele-cta>
      <!-- Netlify Forms: werkt automatisch zodra de site op Netlify staat. Lokaal wordt verzenden nagebootst. -->
      <form class="form" name="offerte" method="POST" action="/bedankt" data-netlify="true" netlify-honeypot="bot-field" data-form data-klachten={JSON.stringify(Object.fromEntries(onderhoud.wijzer.klachten.map((k) => [k.id, k.label])))}
        data-adviezen={JSON.stringify({ hybride: warmtepomp.check.uitkomsten.hybride.richting, electric: warmtepomp.check.uitkomsten.electric.richting, beide: warmtepomp.check.uitkomsten.beide.richting })}>
        <input type="hidden" name="form-name" value="offerte" />
        <p class="sr-only">
          <label>Niet invullen: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <h2 id="form-titel">Waar kan ik je mee helpen?</h2>
        <fieldset class="tegels">
          <legend class="sr-only">Onderwerp</legend>
          {
            tegels.map((t) => (
              <label class:list={['tegel', t.accent]}>
                <input type="radio" name="onderwerp" value={t.waarde} />
                <span class="vak">
                  <Icon name={t.icoon} size={26} />
                  <span>
                    <b>{t.label}</b>
                    <small>{t.sub}</small>
                  </span>
                </span>
              </label>
            ))
          }
        </fieldset>
        <label class="anders">
          <input type="radio" name="onderwerp" value="anders" /> Weet ik nog niet / iets anders
        </label>

        <div class="row">
          <div class="field">
            <label for="naam">Naam <span class="req" aria-hidden="true">*</span></label>
            <input id="naam" name="naam" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="email">E-mailadres <span class="req" aria-hidden="true">*</span></label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
        </div>
        <div class="row">
          <div class="field">
            <label for="telefoon">Telefoonnummer <span class="opt">optioneel</span></label>
            <input id="telefoon" name="telefoon" type="tel" autocomplete="tel" />
          </div>
          <div class="field duo">
            <div>
              <label for="postcode">Postcode <span class="opt">optioneel</span></label>
              <input id="postcode" name="postcode" type="text" autocomplete="postal-code" placeholder="1234 AB" />
            </div>
            <div>
              <label for="plaats">Plaats <span class="opt">optioneel</span></label>
              <input id="plaats" name="plaats" type="text" autocomplete="address-level2" />
            </div>
          </div>
        </div>
        <div class="row">
          <div class="field">
            <label for="woning">Type woning <span class="opt">optioneel</span></label>
            <select id="woning" name="type-woning">
              <option value="">Maak een keuze</option>
              <option>Tussenwoning</option>
              <option>Hoekwoning</option>
              <option>Twee-onder-een-kap</option>
              <option>Vrijstaand</option>
              <option>Appartement</option>
              <option>Bedrijfspand</option>
              <option>Anders</option>
            </select>
          </div>
          <div class="field">
            <label for="voorkeur">Hoe wil je benaderd worden? <span class="opt">optioneel</span></label>
            <select id="voorkeur" name="contactvoorkeur">
              <option value="">Geen voorkeur</option>
              <option>Bellen</option>
              <option>E-mail</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="bericht">Bericht <span class="req" aria-hidden="true">*</span></label>
          <textarea id="bericht" name="bericht" rows="5" required placeholder="Vertel kort wat je zoekt, bijvoorbeeld welke ruimtes je wilt koelen of verwarmen."></textarea>
        </div>

        <p class="note">
          <span aria-hidden="true">*</span> verplicht. Je gegevens gebruik ik alleen om contact met je op te nemen. Zie de{' '}
          <a href="/privacy">privacyverklaring</a>.
        </p>
        <button class="btn" type="submit">Verstuur aanvraag <Icon name="arrow" /></button>
      </form>
    </section>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const params = new URLSearchParams(location.search);

  // Onderwerp en (bij airco) het aantal ruimtes voorinvullen vanaf een dienstpagina
  const onderwerp = params.get('onderwerp');
  if (onderwerp) {
    const radio = form.querySelector<HTMLInputElement>(`input[name="onderwerp"][value="${CSS.escape(onderwerp)}"]`);
    if (radio) radio.checked = true;
  }
  const ruimtes = params.get('ruimtes');
  const bericht = form.querySelector<HTMLTextAreaElement>('#bericht')!;
  if (ruimtes && /^[1-4]\+?$/.test(ruimtes) && !bericht.value) {
    bericht.value = `Ik wil graag advies over een airco voor ${ruimtes} ${ruimtes === '1' ? 'ruimte' : 'ruimtes'}.`;
  }

  // Klacht uit de storingswijzer (onderhoudspagina) voorinvullen
  const klacht = params.get('klacht');
  const klachten = JSON.parse(form.dataset.klachten ?? '{}') as Record<string, string>;
  if (klacht && klachten[klacht] && !bericht.value) {
    bericht.value = `Storing: ${klachten[klacht].toLowerCase()}. `;
  }

  // Uitkomst van de geschiktheidscheck (warmtepompen) voorinvullen
  const advies = params.get('advies');
  const adviezen = JSON.parse(form.dataset.adviezen ?? '{}') as Record<string, string>;
  if (advies && adviezen[advies] && !bericht.value) {
    bericht.value = `Uit de geschiktheidscheck: ${adviezen[advies]} Ik hoor graag of dat klopt voor mijn huis.`;
  }

  // Lokaal is er geen formulierverwerking: verzending nabootsen.
  const isLokaal = ['localhost', '127.0.0.1'].includes(location.hostname);
  form.addEventListener('submit', (e) => {
    if (!isLokaal) return;
    e.preventDefault();
    if (form.reportValidity()) location.href = '/bedankt';
  });
</script>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    min-height: 100vh;
  }
  .links {
    position: relative;
    overflow: hidden;
  }
  .links .glow {
    background:
      radial-gradient(60% 40% at 20% 20%, rgb(66 125 184 / 0.32), transparent 70%);
  }
  .links-inhoud {
    position: sticky;
    top: 0;
    padding: calc(var(--header-h) + clamp(32px, 5vw, 64px)) clamp(20px, 4vw, 56px) 56px;
  }
  .reus {
    font-size: clamp(3.6rem, 8vw, 7.5rem);
    font-stretch: 115%;
    line-height: 0.88;
    letter-spacing: -0.06em;
    margin: 0 0 28px;
  }
  .nummer {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    letter-spacing: -0.02em;
    text-decoration: none;
    margin-bottom: 12px;
  }
  .gegevens,
  .bereik {
    color: var(--muted-on-dark);
    margin: 0 0 12px;
  }
  .gegevens a {
    color: var(--text-on-dark);
  }
  .hierna {
    margin-top: 32px;
    padding: 22px 24px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-dark);
    background: rgb(255 255 255 / 0.04);
  }
  .hierna ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .hierna b {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-right: 10px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.14);
    font-size: 0.8rem;
  }
  .rechts {
    padding: calc(var(--header-h) + clamp(32px, 5vw, 64px)) clamp(20px, 4vw, 64px) clamp(56px, 7vw, 96px);
  }
  .form {
    display: grid;
    gap: 20px;
    max-width: 640px;
  }
  h2 {
    font-size: clamp(1.9rem, 3.4vw, 2.8rem);
    letter-spacing: -0.04em;
    margin: 0;
  }
  .tegels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    border: 0;
    padding: 0;
    margin: 0;
  }
  .tegel {
    position: relative;
    cursor: pointer;
  }
  .tegel input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }
  .vak {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 22px;
    min-height: 128px;
    padding: 18px;
    border-radius: var(--radius-lg);
    background: var(--paper-2);
    border: 1.5px solid var(--line);
    transition:
      background 0.25s,
      border-color 0.25s,
      color 0.25s,
      transform 0.25s var(--ease);
  }
  .vak :global(svg) {
    color: var(--blue-text);
  }
  .warm .vak :global(svg) {
    color: var(--orange-text);
  }
  .vak b {
    display: block;
    font-family: var(--font-display);
    font-size: 1.2rem;
  }
  .vak small {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .tegel:hover .vak {
    transform: translateY(-2px);
  }
  .tegel input:checked + .vak {
    background: var(--blue-text);
    border-color: var(--blue-text);
    color: #fff;
  }
  .warm input:checked + .vak {
    background: var(--orange-text);
    border-color: var(--orange-text);
  }
  .tegel input:checked + .vak :global(svg),
  .tegel input:checked + .vak small {
    color: #fff;
  }
  .tegel input:focus-visible + .vak {
    outline: 3px solid var(--orange);
    outline-offset: 3px;
  }
  .anders {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.92rem;
    color: var(--muted);
    margin-top: -8px;
  }
  .anders input {
    accent-color: var(--orange-btn);
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .field {
    display: grid;
    gap: 8px;
    min-width: 0;
  }
  .field label {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .duo {
    grid-template-columns: 0.8fr 1.2fr;
    gap: 10px;
    align-items: end;
  }
  .row {
    align-items: end;
  }
  .duo > div {
    display: grid;
    gap: 8px;
    min-width: 0;
  }
  .req {
    color: var(--orange-text);
  }
  .opt {
    font-weight: 400;
    color: var(--muted);
    font-size: 0.85rem;
    margin-left: 4px;
  }
  input:not([type='radio']),
  select,
  textarea {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    color: var(--text);
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 13px 14px;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  input:not([type='radio']):focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--orange-btn);
    box-shadow: 0 0 0 4px rgb(234 91 12 / 0.15);
  }
  textarea {
    resize: vertical;
  }
  .note {
    font-size: 0.88rem;
    color: var(--muted);
    margin: 0;
  }
  .form .btn {
    justify-self: start;
  }
  @media (max-width: 960px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }
    .links-inhoud {
      position: static;
      padding-bottom: 40px;
    }
    .rechts {
      padding-top: clamp(40px, 8vw, 64px);
    }
  }
  @media (max-width: 600px) {
    .tegels {
      grid-template-columns: minmax(0, 1fr);
    }
    .vak {
      min-height: 0;
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
    }
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
    .form .btn {
      width: 100%;
    }
  }
</style>
