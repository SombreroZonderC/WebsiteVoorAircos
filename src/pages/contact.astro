---
import { onderhoud, warmtepomp } from '../lib/inhoud';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Vervolgstappen from '../components/Vervolgstappen.astro';
import { bedrijf, mailLink, telLink } from '../lib/bedrijf';

const tegels = [
  { waarde: 'airconditioning', label: 'Koelen', sub: 'Airco', icoon: 'snow', accent: 'koud' },
  { waarde: 'warmtepompen', label: 'Verwarmen', sub: 'Warmtepomp', icoon: 'flame', accent: 'warm' },
  { waarde: 'onderhoud', label: 'Onderhoud', sub: 'of storing', icoon: 'wrench', accent: 'koud' },
] as const;

// Voorinvullen vanaf de dienstpagina's (?klacht=… en ?advies=…): alleen deze vaste teksten zijn mogelijk.
const klachtLabels = Object.fromEntries(onderhoud.wijzer.klachten.map((k) => [k.id, k.label]));
const u = warmtepomp.check.uitkomsten;
const adviesTeksten = { hybride: u.hybride.richting, electric: u.electric.richting, beide: u.beide.richting };
---

<Base
  kopVast
  title="Contact en offerte aanvragen"
  description="Vraag een vrijblijvende offerte aan voor een airco of warmtepomp, of neem contact op met Sjoerd van The CoolFactory in Heeten. Bel 06 211 276 12."
>
  <div class="split">
    <section class="vlak donker links" aria-labelledby="contact-titel" data-geen-mobiele-cta>
      <div class="glow" aria-hidden="true"></div>
      <div class="links-inhoud">
        <p class="eyebrow">Contact</p>
        <h1 id="contact-titel" class="reus">Bel<br />Sjoerd.</h1>
        <a class="nummer" href={telLink}>{bedrijf.telefoon.weergave}</a>
        <p class="gegevens">
          <a href={mailLink}>{bedrijf.email}</a><br />
          {bedrijf.adres.straat}, {bedrijf.adres.postcode} {bedrijf.adres.plaats}
        </p>
        <p class="bereik">
          Bereikbaar: {bedrijf.openingstijden ?? <span class="todo">openingstijden</span>}
        </p>
        <div class="hierna">
          <p class="eyebrow">Wat gebeurt er hierna?</p>
          <Vervolgstappen />
        </div>
      </div>
    </section>

    <section class="vlak licht rechts" aria-labelledby="form-titel" data-geen-mobiele-cta>
      <!-- Netlify Forms: werkt automatisch zodra de site op Netlify staat. Lokaal wordt verzenden nagebootst. -->
      <form
        class="form"
        name="offerte"
        method="POST"
        action="/bedankt"
        data-netlify="true"
        netlify-honeypot="bot-field"
        data-form
        data-klachten={JSON.stringify(klachtLabels)}
        data-adviezen={JSON.stringify(adviesTeksten)}
      >
        <input type="hidden" name="form-name" value="offerte" />
        <p class="sr-only">
          <label>Niet invullen: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <h2 id="form-titel">Waar kan ik je mee helpen?</h2>
        <fieldset class="tegels">
          <legend class="sr-only">Onderwerp</legend>
          {
            tegels.map((t) => (
              <label class:list={['tegel', t.accent]}>
                <input type="radio" name="onderwerp" value={t.waarde} />
                <span class="vak">
                  <Icon name={t.icoon} size={26} />
                  <span>
                    <b>{t.label}</b>
                    <small>{t.sub}</small>
                  </span>
                </span>
              </label>
            ))
          }
        </fieldset>
        <label class="anders">
          <input type="radio" name="onderwerp" value="anders" /> Weet ik nog niet / iets anders
        </label>

        <div class="row">
          <div class="field">
            <label for="naam">Naam <span class="req" aria-hidden="true">*</span></label>
            <input id="naam" name="naam" type="text" autocomplete="name" required maxlength="100" aria-describedby="naam-fout" />
            <p class="fout" id="naam-fout" hidden></p>
          </div>
          <div class="field">
            <label for="email">E-mailadres <span class="req" aria-hidden="true">*</span></label>
            <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="email-fout" />
            <p class="fout" id="email-fout" hidden></p>
          </div>
        </div>
        <div class="row">
          <div class="field">
            <label for="telefoon">Telefoonnummer <span class="opt">optioneel</span></label>
            <input id="telefoon" name="telefoon" type="tel" autocomplete="tel" maxlength="20" pattern="[0-9+() \-]{8,20}" aria-describedby="telefoon-fout" />
            <p class="fout" id="telefoon-fout" hidden></p>
          </div>
          <div class="field duo">
            <div>
              <label for="postcode">Postcode <span class="opt">optioneel</span></label>
              <input id="postcode" name="postcode" type="text" autocomplete="postal-code" placeholder="1234 AB" maxlength="7" pattern="[1-9][0-9]{3} ?[A-Za-z]{2}" aria-describedby="postcode-fout" />
            </div>
            <div>
              <label for="plaats">Plaats <span class="opt">optioneel</span></label>
              <input id="plaats" name="plaats" type="text" autocomplete="address-level2" maxlength="80" />
            </div>
            <p class="fout" id="postcode-fout" hidden></p>
          </div>
        </div>
        <div class="row">
          <div class="field">
            <label for="woning">Type woning <span class="opt">optioneel</span></label>
            <select id="woning" name="type-woning">
              <option value="">Maak een keuze</option>
              <option>Tussenwoning</option>
              <option>Hoekwoning</option>
              <option>Twee-onder-een-kap</option>
              <option>Vrijstaand</option>
              <option>Appartement</option>
              <option>Bedrijfspand</option>
              <option>Anders</option>
            </select>
          </div>
          <div class="field">
            <label for="voorkeur">Hoe wil je benaderd worden? <span class="opt">optioneel</span></label>
            <select id="voorkeur" name="contactvoorkeur">
              <option value="">Geen voorkeur</option>
              <option>Bellen</option>
              <option>E-mail</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="bericht">Bericht <span class="req" aria-hidden="true">*</span></label>
          <textarea id="bericht" name="bericht" rows="5" required maxlength="4000" aria-describedby="bericht-fout" placeholder="Vertel kort wat je zoekt, bijvoorbeeld welke ruimtes je wilt koelen of verwarmen."></textarea>
          <p class="fout" id="bericht-fout" hidden></p>
        </div>

        <p class="note">
          <span aria-hidden="true">*</span> verplicht. Je gegevens gebruik ik alleen om contact met je op te nemen. Zie de{' '}
          <a href="/privacy">privacyverklaring</a>.
        </p>
        <div class="verstuur">
          <button class="btn" type="submit">Verstuur aanvraag <Icon name="arrow" /></button>
          <p class="status" role="status" data-status></p>
        </div>
      </form>
    </section>
  </div>
</Base>

<script>
  import { startContactformulier } from '../scripts/contactformulier';

  const form = document.querySelector<HTMLFormElement>('[data-form]');
  if (form) startContactformulier(form);
</script>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    min-height: 100vh;
  }
  .links {
    position: relative;
    overflow: hidden;
  }
  .links .glow {
    background:
      radial-gradient(60% 40% at 20% 20%, rgb(66 125 184 / 0.32), transparent 70%);
  }
  .links-inhoud {
    position: sticky;
    top: 0;
    padding: calc(var(--header-h) + clamp(32px, 5vw, 64px)) clamp(20px, 4vw, 56px) 56px;
  }
  .reus {
    font-size: clamp(3.6rem, 8vw, 7.5rem);
    font-stretch: 115%;
    line-height: 0.88;
    letter-spacing: -0.06em;
    margin: 0 0 28px;
  }
  .nummer {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    letter-spacing: -0.02em;
    text-decoration: none;
    margin-bottom: 12px;
  }
  .gegevens,
  .bereik {
    color: var(--muted-on-dark);
    margin: 0 0 12px;
  }
  .gegevens a {
    color: var(--text-on-dark);
  }
  .hierna {
    margin-top: 32px;
    padding: 22px 24px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-dark);
    background: rgb(255 255 255 / 0.04);
  }
  .hierna :global(ol) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .hierna :global(li) {
    display: flex;
    align-items: flex-start;
  }
  .hierna :global(b) {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-right: 10px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.14);
    font-size: 0.8rem;
  }
  .rechts {
    padding: calc(var(--header-h) + clamp(32px, 5vw, 64px)) clamp(20px, 4vw, 64px) clamp(56px, 7vw, 96px);
  }
  .form {
    display: grid;
    gap: 20px;
    max-width: 640px;
  }
  h2 {
    font-size: clamp(1.9rem, 3.4vw, 2.8rem);
    letter-spacing: -0.04em;
    margin: 0;
  }
  .tegels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    border: 0;
    padding: 0;
    margin: 0;
  }
  .tegel {
    position: relative;
    cursor: pointer;
  }
  .tegel input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }
  .vak {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 22px;
    min-height: 128px;
    padding: 18px;
    border-radius: var(--radius-lg);
    background: var(--paper-2);
    border: 1.5px solid var(--line);
    transition:
      background 0.25s,
      border-color 0.25s,
      color 0.25s,
      transform 0.25s var(--ease);
  }
  .vak :global(svg) {
    color: var(--blue-text);
  }
  .warm .vak :global(svg) {
    color: var(--orange-text);
  }
  .vak b {
    display: block;
    font-family: var(--font-display);
    font-size: 1.2rem;
  }
  .vak small {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .tegel:hover .vak {
    transform: translateY(-2px);
  }
  .tegel input:checked + .vak {
    background: var(--blue-text);
    border-color: var(--blue-text);
    color: #fff;
  }
  .warm input:checked + .vak {
    background: var(--orange-text);
    border-color: var(--orange-text);
  }
  .tegel input:checked + .vak :global(svg),
  .tegel input:checked + .vak small {
    color: #fff;
  }
  .tegel input:focus-visible + .vak {
    outline: 3px solid var(--orange);
    outline-offset: 3px;
  }
  .anders {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.92rem;
    color: var(--muted);
    margin-top: -8px;
  }
  .anders input {
    accent-color: var(--orange-btn);
  }
  /* Label, veld en foutmelding staan per rij op dezelfde hoogte, ook als een label afbreekt of er
     maar bij één veld een melding staat (subgrid). */
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 18px;
  }
  .field {
    display: grid;
    row-gap: 8px;
    min-width: 0;
  }
  .row > .field {
    grid-row: span 3;
    grid-template-rows: subgrid;
  }
  .field label {
    font-weight: 600;
    font-size: 0.95rem;
    align-self: end;
  }
  .duo {
    grid-template-columns: 0.8fr 1.2fr;
    column-gap: 10px;
  }
  .duo > div {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    min-width: 0;
  }
  .duo > .fout {
    grid-column: 1 / -1;
  }
  .req {
    color: var(--orange-text);
  }
  .opt {
    font-weight: 400;
    color: var(--muted);
    font-size: 0.85rem;
    margin-left: 4px;
  }
  input:not([type='radio']),
  select,
  textarea {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    color: var(--text);
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 13px 14px;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  input:not([type='radio']):focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--orange-btn);
    box-shadow: 0 0 0 4px rgb(234 91 12 / 0.15);
  }
  textarea {
    resize: vertical;
  }
  .note {
    font-size: 0.88rem;
    color: var(--muted);
    margin: 0;
  }
  .verstuur {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
  }
  .status {
    margin: 0;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .fout {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--fout);
  }
  [aria-invalid='true'] {
    border-color: var(--fout) !important;
  }
  button[disabled] {
    opacity: 0.6;
    cursor: progress;
  }
  @media (max-width: 960px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }
    .links-inhoud {
      position: static;
      padding-bottom: 40px;
    }
    .rechts {
      padding-top: clamp(40px, 8vw, 64px);
    }
  }
  @media (max-width: 600px) {
    .tegels {
      grid-template-columns: minmax(0, 1fr);
    }
    .vak {
      min-height: 0;
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
    }
    .row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0;
    }
    .row > .field + .field {
      margin-top: 12px;
    }
    .form .btn {
      width: 100%;
    }
  }
</style>
