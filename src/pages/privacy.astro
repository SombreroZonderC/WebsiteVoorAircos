---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ReuzenHero from '../components/ReuzenHero.astro';

const pagina = (await getEntry('paginas', 'privacy'))!;
const { Content } = await render(pagina);
const p = pagina.data;
---

<Base title={p.seoTitel} description={p.seoOmschrijving} kruimelNaam="Privacyverklaring">
  <div class="paar">
    <ReuzenHero woord="Privacy." kleur="koud" verhouding="smal" eyebrow={p.eyebrow} titel={p.titel} tekst={p.intro} />
    <section class="vlak licht paneel sectie">
      <div class="wrap">
        <div class="prose"><Content /></div>
      </div>
    </section>
  </div>
</Base>

<style>
  .sectie {
    padding-block: clamp(64px, 8vw, 110px);
  }
</style>
