---
// PROTOTYPE – wegwerp. Drie ontwerprichtingen voor de homepage, wisselbaar via ?variant=A|B|C.
// Na de keuze: winnaar verwerken in de echte homepage, deze route en src/components/prototype/ weg uit main.
import '../styles/global.css';
// Eerdere rondes staan in de git-geschiedenis en docs/prototype-ronde-*/.
import VariantA from '../components/prototype/R3Donker.astro';
import VariantB from '../components/prototype/R3Licht.astro';
import VariantC from '../components/prototype/R3Mix.astro';
import PrototypeSwitcher from '../components/prototype/PrototypeSwitcher.astro';

const varianten = [
  { sleutel: 'A', naam: 'Donker + thermometer-keuze' },
  { sleutel: 'B', naam: 'Licht + kies jouw ruimte' },
  { sleutel: 'C', naam: 'Mix + scroll-thermometer' },
];
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Prototype homepage | The CoolFactory</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body style="background:#fff">
    <div data-variant="A"><VariantA /></div>
    <div data-variant="B" hidden><VariantB /></div>
    <div data-variant="C" hidden><VariantC /></div>
    <PrototypeSwitcher varianten={varianten} />
  </body>
</html>
