---
// PROTOTYPE – wegwerp. Drie ontwerprichtingen voor de homepage, wisselbaar via ?variant=A|B|C.
// Na de keuze: winnaar verwerken in de echte homepage, deze route en src/components/prototype/ weg uit main.
import '../styles/global.css';
// Eerdere rondes staan in de git-geschiedenis en docs/prototype-ronde-*/.
import R5Opener from '../components/prototype/R5Opener.astro';
import PrototypeSwitcher from '../components/prototype/PrototypeSwitcher.astro';

const varianten = [
  { sleutel: 'A', naam: 'Diepte (recht, subtiel)' },
  { sleutel: 'B', naam: 'Venster' },
  { sleutel: 'C', naam: 'Lagen' },
];
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Prototype homepage | The CoolFactory</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body style="background:#fff">
    <div data-variant="A"><R5Opener overgang="diepte" prefix="a" /></div>
    <div data-variant="B" hidden><R5Opener overgang="venster" prefix="b" /></div>
    <div data-variant="C" hidden><R5Opener overgang="lagen" prefix="c" /></div>
    <PrototypeSwitcher varianten={varianten} />
  </body>
</html>
