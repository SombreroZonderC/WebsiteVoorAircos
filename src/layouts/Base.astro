---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
import { bedrijf, bedrijfId } from '../lib/bedrijf';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Extra schema.org-objecten voor deze pagina (Service, FAQPage, …) */
  schema?: object[];
}

const { title, description, noindex = false, schema = [] } = Astro.props;
const fullTitle = title.includes(bedrijf.naam) ? title : `${title} | ${bedrijf.naam}`;
const pad = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '');
const canonical = new URL(pad || '/', bedrijf.url).href;



const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'HVACBusiness',
  '@id': bedrijfId,
  name: bedrijf.naam,
  description: `${bedrijf.tagline} in ${bedrijf.adres.plaats} en omgeving. Specialist in ${bedrijf.merk}.`,
  url: bedrijf.url,
  telephone: bedrijf.telefoon.internationaal,
  email: bedrijf.email,
  image: `${bedrijf.url}/images/og.jpg`,
  logo: `${bedrijf.url}/images/logo-origineel.svg`,
  founder: { '@type': 'Person', name: bedrijf.eigenaar },
  brand: { '@type': 'Brand', name: bedrijf.merk },
  address: {
    '@type': 'PostalAddress',
    streetAddress: bedrijf.adres.straat,
    postalCode: bedrijf.adres.postcode,
    addressLocality: bedrijf.adres.plaats,
    addressRegion: bedrijf.adres.provincie,
    addressCountry: bedrijf.adres.land,
  },
  areaServed:
    bedrijf.werkgebied.length > 0
      ? bedrijf.werkgebied.map((name) => ({ '@type': 'City', name }))
      : { '@type': 'City', name: bedrijf.adres.plaats },
  ...(bedrijf.googleReviewsUrl && { sameAs: [bedrijf.googleReviewsUrl] }),
};
---

<!doctype html>
<html lang="nl" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#061419" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:site_name" content={bedrijf.naam} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${bedrijf.url}/images/og.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Naar de inhoud</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileCta />

    <script>
      const els = document.querySelectorAll('[data-reveal]');
      if (!('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
