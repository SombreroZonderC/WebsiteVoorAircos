---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
import Kruimelpad from '../components/Kruimelpad.astro';
import { bedrijf } from '../lib/bedrijf';
import { paginaPad } from '../lib/navigatie';
import { absoluut, bedrijfSchema, jsonLd, kruimelNiveaus, kruimelSchema, ogAfbeelding, volledigeTitel } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Extra schema.org-objecten voor deze pagina (Service, FAQPage, …) */
  schema?: object[];
  /** Header meteen donker (zie Header.astro) */
  kopVast?: boolean;
  /** og:type, standaard 'website' */
  ogType?: 'website' | 'article';
  /** Korte naam in het kruimelpad (standaard: menunaam of titel) */
  kruimelNaam?: string;
}

const { title, description, noindex = false, schema = [], kopVast = false, ogType = 'website', kruimelNaam } = Astro.props;
const fullTitle = volledigeTitel(title);
const pad = paginaPad(Astro.url.pathname);
const canonical = absoluut(pad);

// Kruimelpad op alle vindbare subpagina's: zichtbaar (Kruimelpad.astro) en als structured data.
const niveaus = pad && !noindex ? kruimelNiveaus(pad, kruimelNaam ?? title) : null;
const schemas = [bedrijfSchema(), ...schema, ...(niveaus ? [kruimelSchema(niveaus)] : [])];
---

<!doctype html>
<html lang="nl" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#061419" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:site_name" content={bedrijf.naam} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogAfbeelding(pad)} />
    <meta name="twitter:card" content="summary_large_image" />

    {schemas.map((s) => <script type="application/ld+json" set:html={jsonLd(s)} />)}
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Naar de inhoud</a>
    <Header vast={kopVast} />
    <main id="main">
      {niveaus && <Kruimelpad niveaus={niveaus} />}
      <slot />
    </main>
    <Footer />
    <MobileCta />

    <script>
      import { startDiepte } from '../scripts/diepte';
      import { startReveal } from '../scripts/reveal';

      startDiepte();
      startReveal();
    </script>
  </body>
</html>
